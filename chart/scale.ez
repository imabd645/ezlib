# ============================================================================
# chart/scale.ez — turning numbers into pixels, and axes into round numbers
#
# The axis is the part of a chart that is quietly hard. Data running 0 to 47
# with ticks at 0, 9.4, 18.8, 28.2, 37.6, 47 is technically correct and no one
# can read it. Ticks belong on round numbers, and the axis has to extend to
# reach them, which means the range is chosen from the ticks rather than the
# other way round.
#
# This is Wilkinson's rule, the same one gnuplot and matplotlib use: pick the
# step from 1, 2, 2.5, 5 or 10 times a power of ten, whichever gives closest to
# the requested tick count.
# ============================================================================

# A step that is a "nice" number at least as large as `rough`.
task niceStep(rough) {
    when rough <= 0 { give 1 }
    power = 1
    value = rough
    # Bring the value into [1, 10) and remember by how much.
    while value >= 10 {
        value = value / 10
        power = power * 10
    }
    while value < 1 {
        value = value * 10
        power = power / 10
    }
    # The multipliers people read without thinking.
    when value <= 1 { give 1 * power }
    when value <= 2 { give 2 * power }
    when value <= 2.5 { give 2.5 * power }
    when value <= 5 { give 5 * power }
    give 10 * power
}

# An axis covering [low, high] with about `target` ticks on round numbers.
#
# The returned min and max are usually WIDER than the data, because an axis
# that stops at 47 cannot have a tick at 50. That widening is the whole point:
# it is what makes the labels readable.
export task niceScale(low, high, target = 5) {
    bottom = low
    top = high

    # A flat series has no range to divide. Inventing one keeps the line in the
    # middle of the chart instead of on an edge or at a division by zero.
    when top == bottom {
        when bottom == 0 {
            bottom = -1
            top = 1
        }
        other {
            span = abs(bottom) / 10
            bottom = bottom - span
            top = top + span
        }
    }
    when top < bottom {
        swap = bottom
        bottom = top
        top = swap
    }

    count = target
    when count < 2 { count = 2 }
    increment = niceStep((top - bottom) / (count - 1))
    axisMin = floor(bottom / increment) * increment
    axisMax = ceil(top / increment) * increment

    ticks = []
    # A count guard, not a condition: accumulating a fractional step drifts,
    # and `value <= axisMax` can miss or double the last tick by a rounding error.
    total = round((axisMax - axisMin) / increment)
    i = 0
    while i <= total {
        push(ticks, axisMin + (increment * i))
        i = i + 1
    }
    give { "min": axisMin, "max": axisMax, "step": increment, "ticks": ticks }
}

# Where a value sits between two pixel bounds. Reversed for y, because SVG
# measures downwards and a chart measures upwards.
export task project(value, dataMin, dataMax, pixelLow, pixelHigh) {
    span = dataMax - dataMin
    when span == 0 { give (pixelLow + pixelHigh) / 2 }
    ratio = (value - dataMin) / span
    give pixelLow + (ratio * (pixelHigh - pixelLow))
}

# ── number formatting ───────────────────────────────────────────────────────

# An axis label. The awkward part is that a step of 0.1 needs one decimal and a
# step of 1000 needs none, and printing "1500.0000001" because the step
# accumulated in binary floating point makes the whole chart look broken.
export task formatTick(value, increment) {
    places = decimalsFor(increment)
    give formatNumber(value, places)
}

# How many decimals the step itself needs -- which is NOT a question about its
# magnitude. A step of 2.5 is greater than 1 and still needs one decimal, and
# getting this wrong is not subtle: an axis stepping by 2.5 from 10 renders as
# 10, 13, 15, 18, 20, which looks like a random collection of numbers.
#
# 2.5 is the common case, not an exotic one: any axis spanning about ten units
# with five ticks lands on it.
task decimalsFor(increment) {
    size = abs(increment)
    when size == 0 { give 0 }
    scale = 1
    places = 0
    while places < 6 {
        scaled = size * scale
        # A tolerance, because 0.1 is not exactly 0.1 in binary and an exact
        # comparison would demand six decimals for every fractional step.
        when abs(scaled - round(scaled)) < 0.0000001 { give places }
        scale = scale * 10
        places = places + 1
    }
    give 6
}

export task formatNumber(value, places) {
    negative = value < 0
    size = abs(value)
    scale = 1
    repeat i = 1 to places { scale = scale * 10 }
    rounded = round(size * scale) / scale

    whole = floor(rounded)
    body = str(whole)
    when places > 0 {
        fraction = round((rounded - whole) * scale)
        # Rounding can carry into the whole part: 0.999 at two places is 1.00,
        # not 0.100.
        when fraction >= scale {
            whole = whole + 1
            fraction = 0
            body = str(whole)
        }
        digits = str(fraction)
        while len(digits) < places { digits = "0" + digits }
        body = body + "." + digits
    }
    when negative and rounded != 0 { give "-" + body }
    give body
}

# Thousands separators, for the axis of anything counted in millions.
export task withCommas(text) {
    body = str(text)
    sign = ""
    when startsWith(body, "-") {
        sign = "-"
        body = substr(body, 1, len(body) - 1)
    }
    fraction = ""
    dot = indexOf(body, ".")
    when dot >= 0 {
        fraction = substr(body, dot, len(body) - dot)
        body = substr(body, 0, dot)
    }
    grouped = ""
    count = 0
    i = len(body) - 1
    while i >= 0 {
        grouped = substr(body, i, 1) + grouped
        count = count + 1
        when count % 3 == 0 and i > 0 { grouped = "," + grouped }
        i = i - 1
    }
    give sign + grouped + fraction
}
