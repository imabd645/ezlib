# ============================================================================
# Web - Advanced Flask-like Web Framework & Templating Engine for EZ
# Pure FFI Sockets, Native Templating, Dynamic Routing
# Added: CORS, Rate Limiting, Multipart parsing, Nested Template Tags, 
# FileSession Backend, and Dynamic Buffer fixes.
# ============================================================================

__kernel32 = os_load_lib("kernel32.dll")
__ws32 = os_load_lib("ws2_32.dll")
__msv = os_load_lib("msvcrt.dll")
__sleep = os_get_func(__kernel32, "Sleep")
__SetDllDirectoryA = os_get_func(__kernel32, "SetDllDirectoryA")
# There is no file-deletion builtin in the language; FileSessionStore.delete()
# needs one to retire a session file.
__DeleteFileA = os_get_func(__kernel32, "DeleteFileA")

# --- Locate our own accelerator DLLs ----------------------------------------
# The install root used to be the literal "C:\ezlib\web\dlls", both as the
# SetDllDirectory hint and as the absolute fallback -- so an ezlib installed
# anywhere else (portable checkout, non-admin user, CI, another drive) could not
# find the two DLLs this module cannot run without, and failed with a template
# error instead of anything mentioning paths. The interpreter already resolves
# the stdlib root from EZLIB_PATH; honour the same variable here so the
# framework lands wherever the rest of ezlib did.
__getenv = os_get_func(__msv, "getenv")
export task __ezlib_root() {
    when __getenv != 0 {
        p = os_call(__getenv, "string", "EZLIB_PATH")
        when typeOf(p) == "string" and len(p) > 0 {
            while endsWith(p, "/") or endsWith(p, "\\") { p = substr(p, 0, len(p) - 1) }
            give p
        }
    }
    give "C:\\ezlib"
}

__web_dll_dir = __ezlib_root() + "\\web\\dlls"
when __SetDllDirectoryA != 0 { os_call(__SetDllDirectoryA, "int", __web_dll_dir) }

__web_accel = os_load_lib("web_accel.dll")
when typeOf(__web_accel) == "nil" or __web_accel == 0 { __web_accel = os_load_lib(__web_dll_dir + "\\web_accel.dll") }

__http_accel = os_load_lib("http_accel.dll")
when typeOf(__http_accel) == "nil" or __http_accel == 0 { __http_accel = os_load_lib(__web_dll_dir + "\\http_accel.dll") }

when __SetDllDirectoryA != 0 { os_call(__SetDllDirectoryA, "int", 0) }

# Fail loudly and early. Without this the first symptom of a missing DLL is
# os_get_func returning nil, which surfaces much later as a template-engine
# error string in an HTTP response body -- with nothing pointing at the path.
when typeOf(__http_accel) == "nil" or __http_accel == 0 {
    throw "ezweb: cannot load http_accel.dll from '" + __web_dll_dir + "'. Set EZLIB_PATH to your ezlib root if it is not C:\\ezlib."
}

export model WebAccelFFI {
    static render = os_get_func(__web_accel, "render_template_ext")
    static freeBuf = os_get_func(__web_accel, "free_template_buffer")
}

export model HttpAccelFFI {
    static start = os_get_func(__http_accel, "http_server_start")
    # (there is no `poll` binding: http_server_poll has never existed in the DLL,
    # so the lookup only ever produced a nil that nothing called.)
    static respond = os_get_func(__http_accel, "http_server_respond")
    static stop = os_get_func(__http_accel, "http_server_stop")
    # Streams a file's raw bytes straight from C++ so binary payloads survive:
    # http_server_respond() can only take a C string from EZ, which truncates at
    # the first NUL byte.
    static sendFile = os_get_func(__http_accel, "http_server_send_file")
    static fileSize = os_get_func(__http_accel, "http_file_size")
    static fileMtime = os_get_func(__http_accel, "http_file_mtime")
    # 1 when this process is a prefork worker rather than the supervisor.
    static isWorker = os_get_func(__http_accel, "http_is_worker")
    static getpid = os_get_func(__http_accel, "http_getpid")
    # Raw request body by pointer + length. The body also arrives as the
    # callback's `body` argument, but that crosses the FFI as a C string and so
    # stops at the first NUL -- see request_body_raw().
    static bodyPtr = os_get_func(__http_accel, "http_request_body_ptr")
    static bodyLen = os_get_func(__http_accel, "http_request_body_len")
    # Byte-range file delivery (206) and incremental chunked responses.
    static sendFileRange = os_get_func(__http_accel, "http_server_send_file_range")
    static streamBegin = os_get_func(__http_accel, "http_server_stream_begin")
    static streamWrite = os_get_func(__http_accel, "http_server_stream_write")
    static streamEnd = os_get_func(__http_accel, "http_server_stream_end")
}

# ── Streaming responses ─────────────────────────────────────────────────────
#
# A normal response is assembled as one string with a Content-Length, so the
# entire body must exist in memory first. These stream it instead, using
# Transfer-Encoding: chunked, which is what server-sent events, progress feeds
# and larger-than-RAM exports need.
#
#   @app.get("/events")
#   task events(req) {
#       stream_begin(req, 200, {"Content-Type": "text/event-stream"})
#       i = 0
#       while i < 5 {
#           stream_write(req, "data: tick " + str(i) + "\n\n")
#           i = i + 1
#       }
#       stream_end(req)
#       give STREAMED
#   }
#
# The handler MUST return STREAMED so the framework knows the socket has already
# been answered and does not send a second response on top of the first.
export STREAMED = "__ez_streamed__"

export task stream_begin(req, status = 200, headers = nil) {
    when typeOf(headers) == "nil" { headers = {} }
    phrase = "OK"
    when has_key(WebUtils.HTTP_STATUS, status) { phrase = WebUtils.HTTP_STATUS[status] }
    h = "HTTP/1.1 " + str(status) + " " + phrase + "\r\nServer: EZ Web Framework\r\nTransfer-Encoding: chunked\r\n"
    when not has_key(headers, "Content-Type") { headers["Content-Type"] = "text/plain; charset=utf-8" }
    h = h + emitHeaderLines(headers) + "\r\n"
    give os_call(HttpAccelFFI.streamBegin, "int", req["id"], h)
}

export task stream_write(req, chunk) {
    s = str(chunk)
    when len(s) == 0 { give 0 }
    give os_call(HttpAccelFFI.streamWrite, "int", req["id"], s, len(s))
}

export task stream_end(req) {
    give os_call(HttpAccelFFI.streamEnd, "int", req["id"])
}

# The request body as raw bytes, NULs included.
#
# The `body` handed to the callback is a C string, so the interpreter rebuilds it
# with std::string(const char*) and it ends at the first NUL. Every binary upload
# was silently truncated: a PNG has NULs in its IHDR length at byte 8, so a PNG
# POST arrived 8 bytes long and req["files"] -- a documented feature -- could not
# work for any binary format.
#
# This pulls the bytes across by pointer and length instead. os_buffer_from_ptr
# copies exactly n bytes and buf_to_str builds the string from iterators, so
# nothing is length-guessed anywhere on the path.
#
# Only valid while the request is being handled, which is the only time a handler
# can call it.
export task request_body_raw(req) {
    when not has_key(req, "id") { give "" }
    n = os_call(HttpAccelFFI.bodyLen, "int", req["id"])
    when typeOf(n) == "nil" or n <= 0 { give "" }
    p = os_call(HttpAccelFFI.bodyPtr, "ptr", req["id"])
    when typeOf(p) == "nil" or p == 0 { give "" }
    give buf_to_str(os_buffer_from_ptr(p, n))
}

# This process's id. Useful in logs when running with `workers`, where several
# identical processes serve the same port and log lines are otherwise ambiguous.
export task worker_pid() {
    give os_call(HttpAccelFFI.getpid, "int")
}

# Safe indexOf wrapper that supports 3 arguments
export task indexOfSafe(s, search, start) {
    when typeOf(start) == "nil" { give indexOf(s, search) }
    when start < 0 { start = 0 }
    when start >= len(s) { give -1 }
    sub = substr(s, start, len(s) - start)
    rel = indexOf(sub, search)
    when rel == -1 { give -1 }
    give start + rel
}

Kernel32FFI = {
    "getFileAttributes": os_get_func(__kernel32, "GetFileAttributesA")
}

# --- Cryptographically secure randomness (for session ids) -------------------
# BCryptGenRandom with BCRYPT_USE_SYSTEM_PREFERRED_RNG (0x00000002).
__bcrypt = os_load_lib("bcrypt.dll")
__BCryptGenRandom = 0
when typeOf(__bcrypt) != "nil" and __bcrypt != 0 {
    __BCryptGenRandom = os_get_func(__bcrypt, "BCryptGenRandom")
}

export task secure_token(nbytes) {
    when typeOf(nbytes) == "nil" { nbytes = 32 }
    when __BCryptGenRandom == 0 {
        throw "secure_token: BCryptGenRandom unavailable (bcrypt.dll did not load)"
    }
    buf = os_alloc(nbytes)
    when buf == 0 { throw "secure_token: allocation failed" }
    rc = os_call(__BCryptGenRandom, "int", 0, buf, nbytes, 2)
    when rc != 0 {
        os_free(buf)
        throw "secure_token: BCryptGenRandom failed (NTSTATUS=" + str(rc) + ")"
    }
    hc = "0123456789abcdef"
    outHex = ""
    i = 0
    while i < nbytes {
        b = os_read_byte(buf, i)
        outHex = outHex + substr(hc, (b >> 4) & 15, 1) + substr(hc, b & 15, 1)
        i = i + 1
    }
    os_free(buf)
    give outHex
}

export task file_exists(path) {
    attr = os_call(Kernel32FFI["getFileAttributes"], "ptr", path)
    give attr != -1 and attr != 4294967295
}

export model WebFFI {
    # The socket calls that used to live here (WSAStartup/socket/bind/listen/
    # accept/recv/send/closesocket/atoi) are gone: they were left over from the
    # original pure-EZ socket server, which http_accel.dll replaced. All nine had
    # zero references -- each one only cost an os_get_func on import. The C++
    # accelerator now owns Winsock entirely.
    static strlenFunc = os_get_func(__msv, "strlen")
}

export model WebUtils {
    static HTTP_STATUS = {
        200: "OK", 201: "Created", 202: "Accepted", 204: "No Content",
        # 206/416 accompany byte-range replies. Missing entries do not fall back
        # to a neutral phrase -- they inherit the previous default, so a 416 went
        # out as "HTTP/1.1 416 OK".
        206: "Partial Content",
        301: "Moved Permanently", 302: "Found", 303: "See Other",
        304: "Not Modified", 307: "Temporary Redirect", 308: "Permanent Redirect",
        400: "Bad Request", 401: "Unauthorized", 403: "Forbidden", 404: "Not Found",
        # 405 was absent, so a Method-Not-Allowed reply went out as
        # "HTTP/1.1 405 Not Found" -- a correct code with a contradictory phrase.
        405: "Method Not Allowed", 406: "Not Acceptable", 409: "Conflict",
        410: "Gone", 413: "Payload Too Large", 415: "Unsupported Media Type",
        416: "Range Not Satisfiable",
        422: "Unprocessable Entity", 429: "Too Many Requests",
        500: "Internal Server Error", 501: "Not Implemented",
        502: "Bad Gateway", 503: "Service Unavailable", 504: "Gateway Timeout"
    }

    static task hexVal(c) {
        c = lower(c)
        when c == "0" { give 0 } other when c == "1" { give 1 }
        other when c == "2" { give 2 } other when c == "3" { give 3 }
        other when c == "4" { give 4 } other when c == "5" { give 5 }
        other when c == "6" { give 6 } other when c == "7" { give 7 }
        other when c == "8" { give 8 } other when c == "9" { give 9 }
        other when c == "a" { give 10 } other when c == "b" { give 11 }
        other when c == "c" { give 12 } other when c == "d" { give 13 }
        other when c == "e" { give 14 } other when c == "f" { give 15 }
        give 0
    }

    # NOTE: must NOT be named urlDecode. `give urlDecode(...)` inside a task
    # that is itself named urlDecode compiles to TAIL_CALL (the compiler matches
    # the callee by NAME against the enclosing function), and since the callee is
    # actually the global builtin rather than this task, the VM takes the
    # non-self path: it calls the builtin, then falls through to the LOAD_NIL +
    # RETURN emitted after TAIL_CALL, discarding the result. The task returned
    # nil for every input, which silently broke form-field and query-param
    # decoding below.
    static task decodeUrl(strVal) {
        give urlDecode(str(strVal))
    }

    # The counterpart to decodeUrl. Needed whenever a value is put INTO a URL --
    # a ?next= path, a query argument -- so that a "&", "?" or "#" in the value
    # cannot end the parameter early and inject another one. Named encodeUrl, not
    # urlEncode, for the same tail-call reason as decodeUrl above.
    static task encodeUrl(strVal) {
        give urlEncode(str(strVal))
    }

    # Percent-encoding for a PATH segment.
    #
    # encodeUrl() is form/query encoding, where "+" means space. In a path "+" is
    # a literal plus, so a query-encoded segment is simply wrong there:
    # url_for("/files/<path:p>", {"p": "report final.pdf"}) produced
    # "/files/report+final.pdf", which requests a file whose name contains a "+".
    static task encodePathSeg(strVal) {
        s = urlEncode(str(strVal))
        give replace(s, "+", "%20")
    }

    # Map a filename to a Content-Type. Extracted from serve_static so that
    # send_file and any user code can share one table.
    static task contentTypeFor(fileName) {
        f = lower(str(fileName))
        when endsWith(f, ".html") or endsWith(f, ".htm") { give "text/html" }
        other when endsWith(f, ".css") { give "text/css" }
        other when endsWith(f, ".js") { give "application/javascript" }
        other when endsWith(f, ".json") { give "application/json" }
        other when endsWith(f, ".svg") { give "image/svg+xml" }
        other when endsWith(f, ".txt") { give "text/plain" }
        other when endsWith(f, ".png") { give "image/png" }
        other when endsWith(f, ".jpg") or endsWith(f, ".jpeg") { give "image/jpeg" }
        other when endsWith(f, ".gif") { give "image/gif" }
        other when endsWith(f, ".webp") { give "image/webp" }
        other when endsWith(f, ".ico") { give "image/x-icon" }
        other when endsWith(f, ".pdf") { give "application/pdf" }
        other when endsWith(f, ".zip") { give "application/zip" }
        other when endsWith(f, ".woff") { give "font/woff" }
        other when endsWith(f, ".woff2") { give "font/woff2" }
        other when endsWith(f, ".ttf") { give "font/ttf" }
        other when endsWith(f, ".mp4") { give "video/mp4" }
        other when endsWith(f, ".mp3") { give "audio/mpeg" }
        give "application/octet-stream"
    }

    # Did the client ask us to close the connection? HTTP/1.1 keeps it open by
    # default, so only an explicit "Connection: close" (or an HTTP/1.0 client
    # that did not ask for keep-alive) means close.
    static task wantsClose(req) {
        hdrs = req["headers"]
        when has_key(hdrs, "connection") {
            give indexOf(lower(str(hdrs["connection"])), "close") != -1
        }
        give false
    }

    # Types whose bytes must not be routed through a C string (NUL-truncating).
    static task isBinaryType(ct) {
        c = str(ct)
        when startsWith(c, "text/") { give false }
        when c == "application/javascript" or c == "application/json" { give false }
        when c == "image/svg+xml" { give false }
        give true
    }

    static task escapeHtml(strVal) {
        strVal = str(strVal)
        strVal = replace(strVal, "&", "&amp;")
        strVal = replace(strVal, "<", "&lt;")
        strVal = replace(strVal, ">", "&gt;")
        strVal = replace(strVal, "\"", "&quot;")
        strVal = replace(strVal, "'", "&#39;")
        give strVal
    }
}

# Serialise a header dictionary into "Name: value\r\n" lines.
#
# A value may be an ARRAY, in which case one line is emitted per element. That is
# what makes multiple Set-Cookie headers possible: headers are held in a
# dictionary, so `h["Set-Cookie"] = ...` could only ever hold one cookie and a
# second set_cookie() call silently destroyed the first -- including the session
# cookie, whenever an application set any cookie of its own.
export task emitHeaderLines(h) {
    outStr = ""
    get hk in keys(h) {
        hv = h[hk]
        when typeOf(hv) == "array" {
            get one in hv {
                outStr = outStr + hk + ": " + str(one) + "\r\n"
            }
        } other {
            outStr = outStr + hk + ": " + str(hv) + "\r\n"
        }
    }
    give outStr
}

# Append `value` under `name`, promoting to an array once there is more than one.
# Used for Set-Cookie, where repetition is the only way to send several cookies.
export task addHeader(h, name, value) {
    when not has_key(h, name) {
        h[name] = value
        give h
    }
    cur = h[name]
    when typeOf(cur) == "array" {
        push(cur, value)
        give h
    }
    h[name] = [cur, value]
    give h
}

export model TemplateEngine {
    static task render(tmpl, ctx) {
        when typeOf(WebAccelFFI.render) != "nil" and WebAccelFFI.render != 0 {
            ctx_json = to_json(ctx)
            ptr = os_call(WebAccelFFI.render, "ptr", tmpl, ctx_json, ctx["__base_dir__"])
            
            when typeOf(ptr) != "nil" and ptr != 0 {
                res = os_read_string_ptr(ptr)
                os_call(WebAccelFFI.freeBuf, "int", ptr)
                give res
            }
        }
        give "[TEMPLATE ENGINE ERROR: C++ web_accel.dll failed or is missing]"
    }
}

export task render_template(path, ctx) {
    tmpl = readFile(path)
    lastSlash = -1
    i = 0
    while i < len(path) {
        when substr(path, i, 1) == "/" or substr(path, i, 1) == "\\" { lastSlash = i }
        i = i + 1
    }
    baseDir = ""
    when lastSlash != -1 { baseDir = substr(path, 0, lastSlash + 1) }
    ctx["__base_dir__"] = baseDir
    give TemplateEngine.render(tmpl, ctx)
}

export task redirect(url) {
    give {
        "status": 302,
        "headers": { "Location": url },
        "body": ""
    }
}

# Stream a file's raw bytes to the client, binary-safe (see the __sendfile__
# handling in WebApp._handleCallback). Use this for images/PDFs/downloads:
# returning readFile(path) as a body truncates at the first NUL byte.
#   app.get("/logo", |req| { give send_file("assets/logo.png") })
export task send_file(path, contentType = nil) {
    hdrs = {}
    when typeOf(contentType) != "nil" { hdrs["Content-Type"] = str(contentType) }
    give { "__sendfile__": str(path), "headers": hdrs }
}

# Build a JSON response without hand-assembling the dictionary.
export task json_response(data, status = 200) {
    give { "status": status, "body": data, "headers": { "Content-Type": "application/json" } }
}

# Set-Cookie helper. Previously the only way to set a cookie was to hand-write
# the header string, so attributes were easy to get wrong or forget.
export task set_cookie(res, name, value, opts = nil) {
    when typeOf(opts) == "nil" { opts = {} }
    c = str(name) + "=" + str(value)
    p = "/"
    when has_key(opts, "path") { p = str(opts["path"]) }
    c = c + "; Path=" + p
    when has_key(opts, "maxAge") { c = c + "; Max-Age=" + str(opts["maxAge"]) }
    when has_key(opts, "domain") { c = c + "; Domain=" + str(opts["domain"]) }
    when not has_key(opts, "httpOnly") or opts["httpOnly"] { c = c + "; HttpOnly" }
    when has_key(opts, "secure") and opts["secure"] { c = c + "; Secure" }
    ss = "Lax"
    when has_key(opts, "sameSite") { ss = str(opts["sameSite"]) }
    c = c + "; SameSite=" + ss
    when not has_key(res, "headers") { res["headers"] = {} }
    # Append rather than assign: setting a second cookie used to overwrite the
    # first, so `set_cookie(res, "a", 1)` followed by `set_cookie(res, "b", 2)`
    # sent only "b" -- and any application cookie also displaced the session
    # cookie, silently logging the user out.
    addHeader(res["headers"], "Set-Cookie", c)
    give res
}

# Drop every key from the session (logout). There was no supported way to clear
# a session -- callers had to know the internals.
# Issue a brand-new session id on the next response, retiring the current one.
#
# Call this whenever a session changes privilege level -- above all on login.
# Without it, a session id chosen by an attacker (planted via a link, a subdomain,
# or an XSS-set cookie) survives the login and ends up authenticated as the
# victim: session fixation. Rotating means the id the attacker knows is retired
# server-side, and the id that gets the privileges is one they never saw.
#
# The session CONTENTS are preserved, so this is safe to call mid-request.
export task regenerate_session(req) {
    req["__regenerate_session__"] = true
    give req
}

export task clear_session(req) {
    get k in keys(req["session"]) { req["session"][k] = nil }
    req["session"] = {}
    give req
}

export task flash(req, message, category) {
    when typeOf(category) == "nil" { category = "info" }
    when not has_key(req["session"], "_flashes") { req["session"]["_flashes"] = [] }
    push(req["session"]["_flashes"], {"c": category, "m": message})
}

# Sessions expire after this many seconds without a read or a write. Neither
# store had any expiry at all: records accumulated for the life of the process
# (memory) or forever on disk (files), and the cookie carried no Max-Age either,
# so the only thing that ever ended a session was closing the browser -- which
# the server never learns about.
export SESSION_TTL_SECONDS = 86400

export model MemorySessionStore {
    # ttlSeconds = 0 disables expiry (the previous behaviour) for callers that
    # genuinely want process-lifetime sessions.
    init(ttlSeconds = 86400) {
        self.sessions = {}
        self.touched = {}          # sid -> epoch ms of last get/set
        self.ttlSeconds = ttlSeconds
        self.lastSweep = clock()
        self.sweepIntervalMs = 60000
    }

    task _expired(sid, nowMs) {
        when self.ttlSeconds <= 0 { give false }
        when not has_key(self.touched, sid) { give false }
        give (nowMs - self.touched[sid]) > (self.ttlSeconds * 1000)
    }

    # Expiring only on access would reclaim nothing from ABANDONED sessions --
    # the common case, and the whole point of adding a TTL. Sweep the table on a
    # timer as well, throttled so a busy server does not walk it per request.
    task _sweep(nowMs) {
        when self.ttlSeconds <= 0 { give nil }
        when (nowMs - self.lastSweep) < self.sweepIntervalMs { give nil }
        self.lastSweep = nowMs
        get sid in keys(self.sessions) {
            when self._expired(sid, nowMs) {
                dictRemove(self.sessions, sid)
                when has_key(self.touched, sid) { dictRemove(self.touched, sid) }
            }
        }
    }

    task get(sid) {
        nowMs = clock()
        self._sweep(nowMs)
        when self._expired(sid, nowMs) {
            self.delete(sid)
            give {}
        }
        when has_key(self.sessions, sid) {
            self.touched[sid] = nowMs
            give self.sessions[sid]
        }
        give {}
    }

    task set(sid, data) {
        nowMs = clock()
        self._sweep(nowMs)
        self.sessions[sid] = data
        self.touched[sid] = nowMs
    }

    # Needed to retire a session id rather than merely stop using it -- see
    # regenerate_session(). (dictRemove, not remove: remove() is for arrays.)
    task delete(sid) {
        when has_key(self.sessions, sid) { dictRemove(self.sessions, sid) }
        when has_key(self.touched, sid) { dictRemove(self.touched, sid) }
    }
}

export model FileSessionStore {
    init(storageDir, ttlSeconds = 86400) {
        self.storageDir = storageDir
        self.ttlSeconds = ttlSeconds
    }
    task _getPath(sid) {
        give self.storageDir + "/" + sid + ".json"
    }
    task get(sid) {
        path = self._getPath(sid)
        when file_exists(path) {
            # Expiry keys off the file's mtime rather than a timestamp written
            # inside it, so the on-disk format is unchanged and sessions written
            # by an older build stay readable with nothing to migrate. set()
            # rewrites the file, so mtime IS the last-write time.
            #
            # http_file_mtime returns epoch SECONDS; clock() is epoch
            # MILLISECONDS. Both are wall-clock, so they are comparable once
            # clock() is scaled.
            when self.ttlSeconds > 0 {
                mtime = os_call(HttpAccelFFI.fileMtime, "int", path)
                nowSec = clock() / 1000
                when mtime > 0 and (nowSec - mtime) > self.ttlSeconds {
                    self.delete(sid)
                    give {}
                }
            }
            content = readFile(path)
            give parse_json(content)
        }
        give {}
    }
    task set(sid, data) {
        path = self._getPath(sid)
        writeFile(path, to_json(data))
    }
    task delete(sid) {
        path = self._getPath(sid)
        when file_exists(path) {
            # There is no file-deletion builtin, so go through DeleteFileA. If
            # that is somehow unavailable, truncating to "{}" still retires the
            # session's contents, which is the part that matters -- get() on an
            # empty object hands back a session with nothing in it.
            when __DeleteFileA != 0 {
                os_call(__DeleteFileA, "int", path)
            } other {
                writeFile(path, "{}")
            }
        }
    }
}

# ── Route parameter converters ──────────────────────────────────────────────
#
# A pattern segment "<id>" captures one path segment as a string. A converter
# prefix narrows that: "<int:id>" matches only digits and hands the handler a
# number, so /users/abc no longer reaches a handler that assumed an id and then
# failed somewhere deeper. Supported: int, float, str (the default), and path.
#
# "path" is special -- it swallows the remaining segments, slashes included, so
# "/files/<path:rest>" matches /files/a/b/c.ext with rest = "a/b/c.ext". It only
# makes sense as the final segment.

# Split "<int:id>" into {"type": "int", "name": "id"}. A bare "<id>" is "str".
export task parseParamSeg(seg) {
    inner = substr(seg, 1, len(seg) - 2)
    cIdx = indexOf(inner, ":")
    when cIdx == -1 { give { "type": "str", "name": inner } }
    give { "type": substr(inner, 0, cIdx), "name": substr(inner, cIdx + 1, len(inner) - cIdx - 1) }
}

task __allDigits(s) {
    when len(s) == 0 { give false }
    i = 0
    while i < len(s) {
        when indexOf("0123456789", substr(s, i, 1)) == -1 { give false }
        i = i + 1
    }
    give true
}

# Validate and convert a captured segment. Returns {"ok": bool, "value": v}.
#
# The digit scan is not redundant with num(): std::stoll stops at the first
# non-digit, so num("42abc") is 42 and "<int:id>" would happily match /users/42abc.
export task coerceParam(ptype, raw) {
    when ptype == "int" {
        s = raw
        neg = false
        when startsWith(s, "-") { neg = true  s = substr(s, 1, len(s) - 1) }
        when not __allDigits(s) { give { "ok": false, "value": nil } }
        v = num(s)
        when neg { v = 0 - v }
        give { "ok": true, "value": v }
    }
    when ptype == "float" {
        s = raw
        when startsWith(s, "-") { s = substr(s, 1, len(s) - 1) }
        dot = indexOf(s, ".")
        when dot == -1 {
            when not __allDigits(s) { give { "ok": false, "value": nil } }
        } other {
            whole = substr(s, 0, dot)
            frac = substr(s, dot + 1, len(s) - dot - 1)
            # Exactly one dot, digits on at least one side of it.
            when indexOf(frac, ".") != -1 { give { "ok": false, "value": nil } }
            when len(whole) == 0 and len(frac) == 0 { give { "ok": false, "value": nil } }
            when len(whole) > 0 and not __allDigits(whole) { give { "ok": false, "value": nil } }
            when len(frac) > 0 and not __allDigits(frac) { give { "ok": false, "value": nil } }
        }
        give { "ok": true, "value": num(raw) }
    }
    # str, path, and anything unrecognised: take the segment as-is rather than
    # rejecting it, so an unknown converter degrades to the old behaviour.
    give { "ok": true, "value": raw }
}

# Parse a Range header against a known file size.
#
# Handles the three forms RFC 7233 defines for a single range:
#   bytes=0-499     first 500 bytes
#   bytes=500-      from 500 to the end
#   bytes=-500      the LAST 500 bytes (suffix form)
#
# Returns nil when the header is not a byte range at all (leave it alone),
# {"ok": false} when it is well-formed but unsatisfiable (answer 416), or
# {"ok": true, "start": s, "end": e, "length": n}.
#
# Multi-range ("bytes=0-9,20-29") is deliberately not supported: it requires a
# multipart/byteranges body, and every client that matters falls back to a single
# range or the whole file when only one is offered.
export task parseByteRange(hdr, fileSize) {
    h = trim(str(hdr))
    when not startsWith(h, "bytes=") { give nil }
    spec = trim(substr(h, 6, len(h) - 6))
    when indexOf(spec, ",") != -1 { give nil }
    dash = indexOf(spec, "-")
    when dash == -1 { give nil }

    firstPart = trim(substr(spec, 0, dash))
    lastPart = trim(substr(spec, dash + 1, len(spec) - dash - 1))

    startB = 0
    endB = fileSize - 1
    when len(firstPart) == 0 {
        # Suffix form: the number is a LENGTH from the end, not an offset.
        when len(lastPart) == 0 { give nil }
        n = coerceParam("int", lastPart)
        when not n["ok"] { give nil }
        when n["value"] <= 0 { give { "ok": false } }
        startB = fileSize - n["value"]
        when startB < 0 { startB = 0 }
        endB = fileSize - 1
    } other {
        s = coerceParam("int", firstPart)
        when not s["ok"] { give nil }
        startB = s["value"]
        when len(lastPart) > 0 {
            e = coerceParam("int", lastPart)
            when not e["ok"] { give nil }
            endB = e["value"]
        }
    }

    when endB > fileSize - 1 { endB = fileSize - 1 }
    when startB > endB or startB >= fileSize or startB < 0 { give { "ok": false } }
    give { "ok": true, "start": startB, "end": endB, "length": endB - startB + 1 }
}

export model Router {
    init() {
        self.routes = {}
        self.middlewares = []
    }
    # Returns the handler so this works as a decorator too. A decorator's return
    # value REBINDS the decorated name, so a registrar that returned nothing
    # would silently turn the task it decorated into nil.
    task use(handler) { push(self.middlewares, handler)  give handler }
    task _addRoute(method, pathPattern, handler) {
        parts = split(pathPattern, "/")
        self.routes[method + "_" + pathPattern] = { "pattern": parts, "handler": handler }
    }
    # Two calling styles, same method:
    #   router.get("/x", |req| { ... })      -- direct
    #   @router.get("/x")  task x(req) {}    -- decorator (handler omitted, so a
    #                                           registering closure is returned)
    # patch/head/options were missing here while WebApp had them, so a mounted
    # Router simply could not express those verbs.
    task get(path, handler = nil) { when typeOf(handler) == "nil" { give |fn| { self._addRoute("GET", path, fn)  give fn } } self._addRoute("GET", path, handler)  give handler }
    task post(path, handler = nil) { when typeOf(handler) == "nil" { give |fn| { self._addRoute("POST", path, fn)  give fn } } self._addRoute("POST", path, handler)  give handler }
    task put(path, handler = nil) { when typeOf(handler) == "nil" { give |fn| { self._addRoute("PUT", path, fn)  give fn } } self._addRoute("PUT", path, handler)  give handler }
    task delete(path, handler = nil) { when typeOf(handler) == "nil" { give |fn| { self._addRoute("DELETE", path, fn)  give fn } } self._addRoute("DELETE", path, handler)  give handler }
    task patch(path, handler = nil) { when typeOf(handler) == "nil" { give |fn| { self._addRoute("PATCH", path, fn)  give fn } } self._addRoute("PATCH", path, handler)  give handler }
    task head(path, handler = nil) { when typeOf(handler) == "nil" { give |fn| { self._addRoute("HEAD", path, fn)  give fn } } self._addRoute("HEAD", path, handler)  give handler }
    task options(path, handler = nil) { when typeOf(handler) == "nil" { give |fn| { self._addRoute("OPTIONS", path, fn)  give fn } } self._addRoute("OPTIONS", path, handler)  give handler }
}

export model WebApp {
    init() {
        self.routes = {}
        self.middlewares = []
        self.afterHooks = []
        # Application settings. See config_get/config_set/config_from_env.
        self.config = {}
        self.errorHandlers = { "404": nil, "500": nil }
        # Answer HEAD from the matching GET route (headers only, no body) when no
        # explicit HEAD route exists. Required by HTTP/1.1: a server that answers
        # GET /x must answer HEAD /x identically minus the body, and this used to
        # 405 unless every route was registered twice.
        self.auto_head = true
        # Redirect /path/ <-> /path with 308 when only the other form is
        # registered, instead of 404ing on a trailing slash.
        self.strict_slashes = false
        self.sessionStore = MemorySessionStore()
        # Kept alongside the store rather than read off it, because a custom
        # store is any object with get/set/delete and need not expose a TTL --
        # and has_key() only accepts dictionaries, so the store cannot be probed
        # for the field either. setSessionStore() takes an override.
        self.sessionTTL = SESSION_TTL_SECONDS
        self.sessionCounter = 0
        self.static_cache = {}
        # Cap the static-file cache (entries). It used to be unbounded and never
        # invalidated. 0 disables caching entirely.
        self.static_cache_max = 128
        self.running = false
        # HTTP/1.1 persistent connections. Set app.keep_alive = false to force
        # "Connection: close" on every response (the old behaviour).
        self.keep_alive = true
        # Cache-Control max-age (seconds) advertised for served static files.
        self.static_max_age = 3600
        # Per-request tracing, off by default. The framework used to print
        # "CALLBACK TRIGGERED: ..." and "RESPONDING length: ..." on EVERY
        # request, which is pure noise in any real deployment. Set
        # app.debug = true to get that back.
        self.debug = false
    }
    
    # ttlSeconds sets the Max-Age advertised on the session cookie. Pass the same
    # value the store was constructed with so cookie and store agree on when a
    # session ends; pass 0 for a pure session cookie with no expiry attribute.
    task setSessionStore(store, ttlSeconds = nil) {
        self.sessionStore = store
        when typeOf(ttlSeconds) != "nil" { self.sessionTTL = ttlSeconds }
    }
    
    # These all return the handler so they double as decorators:
    #   @app.use          task logger(req, res) { ... }
    #   @app.after        task addHdr(req, res) { ... }
    #   @app.on_404       task missing(req) { ... }
    #   @app.on_500       task boom(req, err) { ... }
    # A decorator's return value rebinds the decorated name, so returning
    # nothing here would replace the task with nil the moment it was decorated.
    task use(handler) { push(self.middlewares, handler)  give handler }

    # after_request. Runs once the response is decided, for EVERY request --
    # matched, 404, 405 or 500. Middleware only runs BEFORE the handler, so there
    # was previously nowhere to put "add this header to everything" or "log what
    # we actually answered" without repeating it in every route.
    #
    # Signature: (req, res) where res is {"status","headers","body"}. Mutate res,
    # or return a replacement dictionary; return nil to leave it alone.
    task after(handler) { push(self.afterHooks, handler)  give handler }

    # Handler for a specific status code. on_404/on_500 are these two spellings
    # kept for compatibility; on_error covers every other code the framework can
    # produce (401, 403, 405, 413, ...), which previously had no hook at all.
    # Two forms, like the route registrars:
    #   app.on_error(405, |req| { ... })
    #   @app.on_error(405)  task methodNotAllowed(req) { }
    task on_error(code, handler = nil) {
        when typeOf(handler) == "nil" {
            give |fn| { self.errorHandlers[str(code)] = fn  give fn }
        }
        self.errorHandlers[str(code)] = handler
        give handler
    }
    task on_404(handler) { self.errorHandlers["404"] = handler  give handler }
    task on_500(handler) { self.errorHandlers["500"] = handler  give handler }
    
    # Middleware Built-ins
    # Cross-origin access control.
    #
    # This used to hardcode `Access-Control-Allow-Origin: *` with no way to
    # narrow it, and never sent Access-Control-Allow-Headers at all -- so the
    # one case it exists to serve, a JSON API called from a browser, failed at
    # preflight the moment the caller sent Content-Type: application/json or an
    # Authorization header.
    #
    # opts (all optional):
    #   origins     "*" (default) or an array of exact allowed origins.
    #   methods     string, default covers every verb the router supports.
    #   headers     string, default "Content-Type, Authorization, X-Requested-With".
    #   credentials false (default) | true -- send Allow-Credentials.
    #   maxAge      preflight cache seconds, default 86400.
    #
    # With credentials:true the wildcard is NOT allowed by the CORS spec (a
    # browser rejects "*" on a credentialed request), so an explicit origins
    # array is required and the matching origin is echoed back instead.
    task useCORS(opts = nil) {
        when typeOf(opts) == "nil" { opts = {} }

        origins = "*"
        when has_key(opts, "origins") { origins = opts["origins"] }
        methods = "GET, POST, PUT, PATCH, DELETE, HEAD, OPTIONS"
        when has_key(opts, "methods") { methods = str(opts["methods"]) }
        allowHeaders = "Content-Type, Authorization, X-Requested-With"
        when has_key(opts, "headers") { allowHeaders = str(opts["headers"]) }
        credentials = false
        when has_key(opts, "credentials") { credentials = opts["credentials"] }
        maxAge = 86400
        when has_key(opts, "maxAge") { maxAge = opts["maxAge"] }

        when credentials and typeOf(origins) != "array" {
            throw "useCORS: credentials:true requires an explicit origins array -- the CORS spec forbids '*' on credentialed requests."
        }

        self.use(|req, res| {
            reqOrigin = ""
            when has_key(req["headers"], "origin") { reqOrigin = str(req["headers"]["origin"]) }

            # A CORS preflight is specifically an OPTIONS carrying BOTH Origin
            # and Access-Control-Request-Method. Treating every OPTIONS as a
            # preflight makes an application's own `app.options(...)` route
            # unreachable the moment CORS is enabled, because this middleware
            # answers first and short-circuits the router.
            isPreflight = false
            when req["method"] == "OPTIONS" and reqOrigin != "" {
                when has_key(req["headers"], "access-control-request-method") { isPreflight = true }
            }

            allowed = ""
            when typeOf(origins) == "array" {
                # Echo the caller's origin only when it is on the list. Echoing
                # anything else would make the allowlist decorative.
                get o in origins {
                    when str(o) == reqOrigin and reqOrigin != "" { allowed = reqOrigin }
                }
            } other {
                allowed = "*"
            }

            # No match: send no CORS headers at all. The browser then blocks the
            # read, which is the correct outcome for a disallowed origin. A
            # non-preflight request still falls through to the router -- CORS
            # governs what the browser will hand to script, not whether the
            # server answers.
            when allowed == "" {
                when isPreflight { give { "status": 204, "body": "" } }
                give nil
            }

            res["headers"]["Access-Control-Allow-Origin"] = allowed
            when allowed != "*" {
                # The response now differs per Origin, so any shared cache must
                # key on it. Without Vary a proxy can serve one origin's
                # response to another.
                res["headers"]["Vary"] = "Origin"
            }
            when credentials { res["headers"]["Access-Control-Allow-Credentials"] = "true" }

            when isPreflight {
                # 204 rather than 200: there is no body, and some clients treat
                # a 200 with Content-Length: 0 as a malformed preflight
                # response.
                #
                # Built as a complete header set: returning a response from
                # middleware replaces the response, so anything set on `res`
                # above would be dropped on this path.
                pf = {
                    "Access-Control-Allow-Origin": allowed,
                    "Access-Control-Allow-Methods": methods,
                    "Access-Control-Allow-Headers": allowHeaders,
                    "Access-Control-Max-Age": str(maxAge)
                }
                when allowed != "*" { pf["Vary"] = "Origin" }
                when credentials { pf["Access-Control-Allow-Credentials"] = "true" }
                give { "status": 204, "body": "", "headers": pf }
            }
            give nil
        })
    }

    # Standard hardening headers on every response.
    #
    # These have to be set somewhere, and "somewhere" was previously every
    # handler by hand -- so in practice they were absent. Defaults are the
    # conservative ones that do not break an ordinary server-rendered app:
    #
    #   nosniff          stops a browser second-guessing Content-Type, which is
    #                    how a user-uploaded .txt gets executed as script
    #   frameOptions     DENY -- blocks clickjacking via <iframe>
    #   referrer         strict-origin-when-cross-origin, so paths and query
    #                    strings (often carrying tokens) do not leak off-site
    #   hsts             OFF by default: sending it over plain HTTP is
    #                    meaningless, and once a browser has pinned it a
    #                    misconfigured deployment is unreachable for max-age
    #                    seconds. Enable it deliberately, behind TLS.
    #   csp              OFF by default: a wrong CSP silently breaks a working
    #                    page, and no default is right for every app.
    task useSecurityHeaders(opts = nil) {
        when typeOf(opts) == "nil" { opts = {} }

        nosniff = true
        when has_key(opts, "nosniff") { nosniff = opts["nosniff"] }
        frameOptions = "DENY"
        when has_key(opts, "frameOptions") { frameOptions = opts["frameOptions"] }
        referrer = "strict-origin-when-cross-origin"
        when has_key(opts, "referrer") { referrer = opts["referrer"] }
        csp = nil
        when has_key(opts, "csp") { csp = opts["csp"] }
        hsts = 0
        when has_key(opts, "hsts") { hsts = opts["hsts"] }
        permissions = nil
        when has_key(opts, "permissions") { permissions = opts["permissions"] }

        # An after-hook, not middleware: middleware runs BEFORE the handler, so a
        # header it sets is lost the moment a handler returns its own headers
        # dictionary. after() sees the finished response.
        self.after(|req, res| {
            h = res["headers"]
            when nosniff { h["X-Content-Type-Options"] = "nosniff" }
            when typeOf(frameOptions) == "string" and frameOptions != "" { h["X-Frame-Options"] = frameOptions }
            when typeOf(referrer) == "string" and referrer != "" { h["Referrer-Policy"] = referrer }
            when typeOf(csp) == "string" and csp != "" { h["Content-Security-Policy"] = csp }
            when typeOf(permissions) == "string" and permissions != "" { h["Permissions-Policy"] = permissions }
            when hsts > 0 { h["Strict-Transport-Security"] = "max-age=" + str(hsts) + "; includeSubDomains" }
            give nil
        })
    }

    # Rate-limit per client.
    #
    # The key used to be the constant "client", which made this a single global
    # bucket rather than a per-client limit: one busy caller would 429 everyone
    # else. The C++ side now passes the peer address from accept() through to
    # req["ip"], so clients can actually be told apart.
    #
    # Resolution order:
    #   1. keyFn(req)              -- caller decides (session id, API key, ...)
    #   2. X-Forwarded-For/X-Real-IP when trustProxy is true (behind a reverse
    #      proxy, req["ip"] is the PROXY, so the header is the real client).
    #      Only honour these when you actually run behind a proxy: they are
    #      client-supplied and trivially spoofed to evade the limit.
    #   3. req["ip"]               -- the real peer address.
    #
    # `maxKeys` bounds the tracking table. It previously grew forever: pruning
    # rewrote store[ip] to an empty array rather than removing the key, so every
    # distinct client address ever seen stayed resident for the life of the
    # process. A spray of unique sources -- free to generate when trustProxy is
    # on, since X-Forwarded-For is attacker-controlled -- turned the middleware
    # meant to prevent abuse into the memory-exhaustion vector.
    #
    # Now an emptied bucket is deleted, and when the table is still at the cap
    # after that sweep the request is allowed through rather than tracked, so
    # the table can never exceed maxKeys.
    task useRateLimiter(maxReq, timeWindowMs, keyFn = nil, trustProxy = false, maxKeys = 10000) {
        store = {}
        self.use(|req, res| {
            ip = str(req["ip"])
            when typeOf(keyFn) != "nil" {
                ip = str(keyFn(req))
            } other when trustProxy {
                hdrs = req["headers"]
                when has_key(hdrs, "x-forwarded-for") {
                    # May be "client, proxy1, proxy2" -- the first entry is the client.
                    xff = str(hdrs["x-forwarded-for"])
                    cIdx = indexOf(xff, ",")
                    when cIdx != -1 { ip = trim(substr(xff, 0, cIdx)) } other { ip = trim(xff) }
                } other when has_key(hdrs, "x-real-ip") {
                    ip = trim(str(hdrs["x-real-ip"]))
                }
            }
            when ip == "" or ip == "nil" { ip = "unknown" }
            now = clock()

            # Sweep every bucket, not just this client's, and DELETE the ones
            # that emptied. Sweeping only the current key let idle clients
            # accumulate: a key was created on first sight and never removed.
            # The sweep is bounded by the table size, which is itself capped
            # below, so this stays O(maxKeys) in the worst case.
            # dictRemove(), not `store[k] = nil`: assigning nil leaves the key in
            # place (has_key still reports true), so nulling would have left the
            # leak exactly as it was. keys() returns a snapshot array, so
            # removing during this walk is safe.
            get k in keys(store) {
                fresh = []
                get t in store[k] { when now - t < timeWindowMs { push(fresh, t) } }
                when len(fresh) == 0 {
                    dictRemove(store, k)
                } other {
                    store[k] = fresh
                }
            }

            seen = []
            when has_key(store, ip) { seen = store[ip] }

            when len(seen) >= maxReq {
                give {"status": 429, "body": "Too Many Requests"}
            }

            # Only start tracking a NEW client while there is room. At the cap
            # the request is served normally but not recorded -- the limiter
            # degrades to letting traffic through instead of growing without
            # bound. Existing keys keep being updated regardless, so clients
            # already under watch stay limited.
            when has_key(store, ip) {
                push(store[ip], now)
            } other when len(keys(store)) < maxKeys {
                store[ip] = [now]
            }
            give nil
        })
    }
    
    task serve_static(url_prefix, folder_path) {
        while endsWith(url_prefix, "/") { url_prefix = substr(url_prefix, 0, len(url_prefix) - 1) }
        while endsWith(folder_path, "/") { folder_path = substr(folder_path, 0, len(folder_path) - 1) }
        
        self._addRoute("GET", url_prefix + "/<file>", |req| {
            fileName = req["params"]["file"]
            # Reject traversal AND separators. `<file>` is a single URL segment,
            # but the value is percent-DECODED after the split, so "%2F" arrives
            # here as "/" and could escape folder_path even without a "..".
            when indexOf(fileName, "..") != -1 { give {"status": 403, "body": "Forbidden"} }
            when indexOf(fileName, "/") != -1 or indexOf(fileName, "\\") != -1 or indexOf(fileName, ":") != -1 {
                give {"status": 403, "body": "Forbidden"}
            }
            fullFile = folder_path + "/" + fileName
            when not file_exists(fullFile) { give {"status": 404, "body": "File Not Found"} }

            contentType = WebUtils.contentTypeFor(fileName)

            # ETag from size+mtime. Browsers re-request assets constantly; without
            # a validator every one of those re-sends the whole file. With it, an
            # unchanged asset costs a 304 and no body at all.
            etag = "\"" + str(os_call(HttpAccelFFI.fileSize, "int", fullFile)) + "-" + str(os_call(HttpAccelFFI.fileMtime, "int", fullFile)) + "\""
            cacheHdrs = {
                "Content-Type": contentType,
                "ETag": etag,
                "Cache-Control": "public, max-age=" + str(self.static_max_age)
            }
            when has_key(req["headers"], "if-none-match") {
                when str(req["headers"]["if-none-match"]) == etag {
                    give { "status": 304, "body": "", "headers": cacheHdrs }
                }
            }

            # Byte ranges, so media can seek and downloads can resume. Without
            # Accept-Ranges a browser scrubbing a video re-fetches the whole file
            # from byte zero on every seek.
            fsize = os_call(HttpAccelFFI.fileSize, "int", fullFile)
            cacheHdrs["Accept-Ranges"] = "bytes"
            when has_key(req["headers"], "range") and fsize > 0 {
                rng = parseByteRange(str(req["headers"]["range"]), fsize)
                when typeOf(rng) != "nil" {
                    when not rng["ok"] {
                        # Unsatisfiable: RFC 7233 wants 416 plus the real length,
                        # so the client can correct itself.
                        give {
                            "status": 416,
                            "body": "",
                            "headers": { "Content-Range": "bytes */" + str(fsize), "Accept-Ranges": "bytes" }
                        }
                    }
                    rh = {}
                    get ck in keys(cacheHdrs) { rh[ck] = cacheHdrs[ck] }
                    rh["Content-Range"] = "bytes " + str(rng["start"]) + "-" + str(rng["end"]) + "/" + str(fsize)
                    give {
                        "__sendfile__": fullFile,
                        "__range__": rng,
                        "status": 206,
                        "headers": rh
                    }
                }
            }

            # Binary types stream straight from C++. They CANNOT go through the
            # normal response path: the body would be handed to the FFI as a C
            # string and Content-Length computed with strlen(), both of which stop
            # at the first NUL byte -- so every .png/.jpg this advertised was
            # served truncated.
            when WebUtils.isBinaryType(contentType) {
                give { "__sendfile__": fullFile, "headers": cacheHdrs }
            }

            # A cache hit is only valid while the file is unchanged. The entry
            # records the etag it was built from; since the etag is size+mtime,
            # comparing it against the freshly computed one detects any edit and
            # re-reads. Without this the cache returned the stale BODY *and* the
            # stale ETag header, so a file edit was never picked up until the
            # process restarted, and clients kept re-validating into old content.
            when has_key(self.static_cache, fullFile) {
                entry = self.static_cache[fullFile]
                when entry["etag"] == etag { give entry["resp"] }
            }

            content = readFile(fullFile)
            resp = {
                "status": 200,
                "body": content,
                "headers": cacheHdrs
            }
            # Bound the cache. It previously grew forever, so a directory of
            # files was pinned in memory for the process's life. Keep it opt-out
            # and capped; set app.static_cache_max = 0 to disable caching.
            # A stale entry is replaced in place, so refreshing an already-cached
            # file does not need to fit under the cap.
            when self.static_cache_max > 0 {
                when has_key(self.static_cache, fullFile) or len(keys(self.static_cache)) < self.static_cache_max {
                    self.static_cache[fullFile] = { "etag": etag, "resp": resp }
                }
            }
            give resp
        })
    }
    
    task _addRoute(method, pathPattern, handler) {
        parts = split(pathPattern, "/")
        self.routes[method + "_" + pathPattern] = { "pattern": parts, "handler": handler }
    }
    
    # Two calling styles, same method:
    #   app.get("/x", |req| { ... })       -- direct
    #   @app.get("/x")  task x(req) { }    -- decorator; handler is omitted, so a
    #                                         registering closure comes back and
    #                                         the compiler applies it to the task
    # Both forms return the handler, because a decorator's return value REBINDS
    # the decorated name -- returning nothing would turn the task into nil.
    task get(path, handler = nil) { when typeOf(handler) == "nil" { give |fn| { self._addRoute("GET", path, fn)  give fn } } self._addRoute("GET", path, handler)  give handler }
    task post(path, handler = nil) { when typeOf(handler) == "nil" { give |fn| { self._addRoute("POST", path, fn)  give fn } } self._addRoute("POST", path, handler)  give handler }
    task put(path, handler = nil) { when typeOf(handler) == "nil" { give |fn| { self._addRoute("PUT", path, fn)  give fn } } self._addRoute("PUT", path, handler)  give handler }
    task delete(path, handler = nil) { when typeOf(handler) == "nil" { give |fn| { self._addRoute("DELETE", path, fn)  give fn } } self._addRoute("DELETE", path, handler)  give handler }
    # PATCH/HEAD/OPTIONS were missing entirely: only GET/POST/PUT/DELETE could be
    # registered, so a PATCH endpoint (the normal verb for partial updates) was
    # impossible and OPTIONS only answered if you happened to enable CORS.
    task patch(path, handler = nil) { when typeOf(handler) == "nil" { give |fn| { self._addRoute("PATCH", path, fn)  give fn } } self._addRoute("PATCH", path, handler)  give handler }
    task head(path, handler = nil) { when typeOf(handler) == "nil" { give |fn| { self._addRoute("HEAD", path, fn)  give fn } } self._addRoute("HEAD", path, handler)  give handler }
    task options(path, handler = nil) { when typeOf(handler) == "nil" { give |fn| { self._addRoute("OPTIONS", path, fn)  give fn } } self._addRoute("OPTIONS", path, handler)  give handler }

    # Find the best route for (method, path segments), or nil.
    #
    # Extracted from the request pipeline so HEAD can retry the lookup as GET.
    # Returns {"route": <routeObj>, "params": {...}}.
    #
    # Picks the MOST SPECIFIC match, not simply the first found: keys() over a
    # dictionary is hash order, not registration order, so "first match wins"
    # made routing depend on hashing. "/users/<id>" hashes ahead of "/users/new",
    # so GET /users/new matched the parameterised route with id="new" and the
    # static route was unreachable. Scoring by literal-segment count makes a
    # static segment always beat a parameter, independent of hash order.
    task _matchRoute(method, reqParts) {
        routeKeys = keys(self.routes)
        bestScore = -1
        bestRoute = nil
        bestParams = {}
        i_route = 0
        while i_route < len(routeKeys) {
            rKey = routeKeys[i_route]
            when startsWith(rKey, method + "_") {
                routeObj = self.routes[rKey]
                pattParts = routeObj["pattern"]

                # A trailing <path:...> absorbs every remaining segment, so the
                # request may be LONGER than the pattern. Every other pattern
                # still requires an exact segment count.
                lastIdx = len(pattParts) - 1
                hasPath = false
                when lastIdx >= 0 {
                    lastP = pattParts[lastIdx]
                    when startsWith(lastP, "<") and indexOf(lastP, ">") != -1 {
                        when parseParamSeg(lastP)["type"] == "path" { hasPath = true }
                    }
                }

                lenOk = len(pattParts) == len(reqParts)
                when hasPath and len(reqParts) >= len(pattParts) { lenOk = true }

                when lenOk {
                    is_match = true
                    tempParams = {}
                    # Specificity, summed per segment:
                    #   literal        100
                    #   typed param     10   (<int:id>)
                    #   plain param      5   (<id>)
                    #   path param       1   (greediest, so ranked last)
                    #
                    # Counting only literals was not enough: "/users/<int:id>"
                    # and "/users/<name>" both have one literal, so the winner
                    # came down to keys() hash order and /users/42 could land on
                    # the string route. A converter is a narrower claim on the
                    # segment and must outrank a bare parameter.
                    staticCount = 0
                    i = 0
                    while i < len(pattParts) {
                        p1 = pattParts[i]
                        p2 = reqParts[i]
                        when startsWith(p1, "<") and indexOf(p1, ">") != -1 {
                            spec = parseParamSeg(p1)
                            when spec["type"] == "path" { staticCount = staticCount + 1 }
                            other when spec["type"] == "str" { staticCount = staticCount + 5 }
                            other { staticCount = staticCount + 10 }
                            when spec["type"] == "path" and i == lastIdx {
                                # Re-join the tail. Each segment is decoded
                                # individually so an encoded %2F inside a segment
                                # does not turn into a separator.
                                tail = []
                                j = i
                                while j < len(reqParts) {
                                    push(tail, WebUtils.decodeUrl(reqParts[j]))
                                    j = j + 1
                                }
                                tempParams[spec["name"]] = join(tail, "/")
                            } other {
                                conv = coerceParam(spec["type"], WebUtils.decodeUrl(p2))
                                when conv["ok"] {
                                    tempParams[spec["name"]] = conv["value"]
                                } other {
                                    # Wrong shape for the converter: this route
                                    # does not match, so a sibling route (or the
                                    # 404) gets its chance.
                                    is_match = false
                                    i = len(pattParts)
                                }
                            }
                        } other when p1 != p2 {
                            is_match = false
                            i = len(pattParts)
                        } other {
                            staticCount = staticCount + 100
                        }
                        when is_match { i = i + 1 }
                    }
                    when is_match and staticCount > bestScore {
                        bestScore = staticCount
                        bestRoute = routeObj
                        bestParams = tempParams
                    }
                }
            }
            i_route = i_route + 1
        }
        when bestRoute == nil { give nil }
        give { "route": bestRoute, "params": bestParams }
    }

    # Build a URL from a route pattern and its parameters.
    #
    # The point is not string convenience -- it is that the pattern is CHECKED.
    # Hand-writing "/users/" + str(id) in a template produces a dead link the
    # moment a route is renamed, silently and everywhere. url_for throws instead,
    # at the first request that would have produced the bad link.
    #
    #   app.url_for("/users/<id>", {"id": 42})            -> "/users/42"
    #   app.url_for("/users/<int:id>", {"id": 42})        -> "/users/42"
    #   app.url_for("/search", {"q": "a b"})              -> "/search?q=a%20b"
    #
    # Parameters not consumed by the pattern become the query string.
    task url_for(pattern, params = nil, method = "GET") {
        when typeOf(params) == "nil" { params = {} }
        when not has_key(self.routes, method + "_" + pattern) {
            throw "url_for: no " + method + " route registered for '" + pattern + "'"
        }

        used = {}
        outParts = []
        get seg in split(pattern, "/") {
            when startsWith(seg, "<") and indexOf(seg, ">") != -1 {
                spec = parseParamSeg(seg)
                nm = spec["name"]
                when not has_key(params, nm) {
                    throw "url_for: '" + pattern + "' needs a value for '" + nm + "'"
                }
                used[nm] = true
                v = str(params[nm])
                # A path parameter holds separators on purpose, so encode its
                # segments individually and keep the slashes.
                when spec["type"] == "path" {
                    enc = []
                    get piece in split(v, "/") { push(enc, WebUtils.encodePathSeg(piece)) }
                    push(outParts, join(enc, "/"))
                } other {
                    push(outParts, WebUtils.encodePathSeg(v))
                }
            } other {
                push(outParts, seg)
            }
        }

        url = join(outParts, "/")
        when url == "" { url = "/" }

        qs = ""
        get k in keys(params) {
            when not has_key(used, k) {
                when qs != "" { qs = qs + "&" }
                qs = qs + WebUtils.encodeUrl(str(k)) + "=" + WebUtils.encodeUrl(str(params[k]))
            }
        }
        when qs != "" { url = url + "?" + qs }
        give url
    }

    # Which methods are registered for a path that did not match the request's
    # method? Used to answer 405 + Allow instead of a misleading 404.
    # Now delegates to _matchRoute rather than repeating a simplified copy of it.
    # The copy ignored parameter converters, so it claimed a match wherever any
    # "<...>" segment lined up: GET /price/1.2.3 against "/price/<float:amount>"
    # reported GET as allowed and answered 405, when in fact no route matches at
    # all and the honest answer is 404. One matcher, one behaviour.
    task _allowedMethodsFor(reqParts) {
        found = []
        hasGet = false
        hasHead = false
        get m in ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"] {
            when typeOf(self._matchRoute(m, reqParts)) != "nil" {
                push(found, m)
                when m == "GET" { hasGet = true }
                when m == "HEAD" { hasHead = true }
            }
        }
        # auto_head answers HEAD from the GET route, so HEAD really is allowed
        # even though no HEAD route is registered. Omitting it made the Allow
        # header contradict what the server actually does.
        when self.auto_head and hasGet and not hasHead { push(found, "HEAD") }
        give found
    }

    # ── Test client ─────────────────────────────────────────────────────────
    #
    # Run a request through the app without binding a socket. There was no way
    # to exercise a route except by starting a real server and talking HTTP to
    # it, which is why the shipped test suite covers helpers and never once
    # checks that a route returns what it should.
    #
    #   r = app.test_request("GET", "/users/42")
    #   r["status"]        # 200
    #   r["body"]          # handler output as a string
    #   r["headers"]       # dictionary, array values for repeated headers
    #
    # opts (all optional): body, headers, form, query, cookies, session.
    # Header names are lower-cased for you, matching what the real server hands
    # a handler.
    #
    # This shares _matchRoute, the middleware list, the after hooks and the error
    # handlers with the live pipeline, so routing, params, short-circuits and
    # after-hooks all behave identically. It does NOT serialise to bytes, so it
    # does not exercise gzip, chunked framing or keep-alive.
    task test_request(method, path, opts = nil) {
        when typeOf(opts) == "nil" { opts = {} }

        req = {}
        req["id"] = -1
        req["method"] = upper(str(method))
        req["path"] = str(path)
        req["fullPath"] = str(path)
        req["ip"] = "127.0.0.1"
        req["body"] = ""
        when has_key(opts, "body") { req["body"] = str(opts["body"]) }
        req["headers"] = {}
        when has_key(opts, "headers") {
            get hk in keys(opts["headers"]) { req["headers"][lower(str(hk))] = opts["headers"][hk] }
        }
        req["query"] = {}
        when has_key(opts, "query") { req["query"] = opts["query"] }
        req["form"] = {}
        when has_key(opts, "form") { req["form"] = opts["form"] }
        req["files"] = {}
        req["params"] = {}
        req["cookies"] = {}
        when has_key(opts, "cookies") { req["cookies"] = opts["cookies"] }
        req["session"] = {}
        when has_key(opts, "session") { req["session"] = opts["session"] }

        reqParts = split(req["path"], "/")
        resObj = { "status": 200, "headers": {}, "body": "" }

        found = self._matchRoute(req["method"], reqParts)
        headOnly = false
        when typeOf(found) == "nil" and req["method"] == "HEAD" and self.auto_head {
            found = self._matchRoute("GET", reqParts)
            when typeOf(found) != "nil" { headOnly = true }
        }
        when typeOf(found) != "nil" { req["params"] = found["params"] }

        result = nil
        i_mid = 0
        while i_mid < len(self.middlewares) {
            m_res = self.middlewares[i_mid](req, resObj)
            when m_res != nil { result = m_res  i_mid = len(self.middlewares) }
            other { i_mid = i_mid + 1 }
        }

        status = 200
        body = ""
        hdrs = resObj["headers"]

        when result == nil and typeOf(found) != "nil" {
            result = found["route"]["handler"](req)
        }

        when typeOf(result) == "nil" {
            # Nothing matched and no middleware answered: same 404/405 decision
            # the live pipeline makes.
            allowed = self._allowedMethodsFor(reqParts)
            status = 404
            when len(allowed) > 0 { status = 405  hdrs["Allow"] = join(allowed, ", ") }
            custom = nil
            when has_key(self.errorHandlers, str(status)) { custom = self.errorHandlers[str(status)] }
            when typeOf(custom) != "nil" {
                cres = custom(req)
                when typeOf(cres) == "dictionary" {
                    when has_key(cres, "status") { status = cres["status"] }
                    when has_key(cres, "body") { body = str(cres["body"]) }
                } other { body = str(cres) }
            } other {
                body = "<h1>" + str(status) + "</h1>"
            }
        } other when typeOf(result) == "string" {
            body = result
        } other when typeOf(result) == "dictionary" {
            when has_key(result, "status") { status = result["status"] }
            when has_key(result, "body") {
                bd = result["body"]
                when typeOf(bd) == "dictionary" or typeOf(bd) == "array" { body = to_json(bd) }
                other { body = str(bd) }
            } other { body = to_json(result) }
            when has_key(result, "headers") {
                get hk in keys(result["headers"]) { hdrs[hk] = result["headers"][hk] }
            }
        } other when typeOf(result) == "array" {
            body = to_json(result)
        } other {
            body = str(result)
        }

        aRes = { "status": status, "headers": hdrs, "body": body }
        get af in self.afterHooks {
            replaced = af(req, aRes)
            when typeOf(replaced) == "dictionary" { aRes = replaced }
        }
        when headOnly { aRes["body"] = "" }
        aRes["request"] = req
        give aRes
    }

    # ── Access log ──────────────────────────────────────────────────────────
    #
    # One line per request: method, path, status, duration. app.debug printed a
    # byte count and nothing else, so there was no way to see what was being
    # served or how slowly.
    #
    # sink defaults to stdout; pass a function to send lines elsewhere.
    task useAccessLog(sink = nil) {
        self.use(|req, res| {
            req["__startedAt__"] = clock()
            give nil
        })
        self.after(|req, res| {
            started = clock()
            when has_key(req, "__startedAt__") { started = req["__startedAt__"] }
            ms = clock() - started
            line = str(req["method"]) + " " + str(req["path"]) + " " + str(res["status"]) + " " + str(ms) + "ms " + str(req["ip"])
            when typeOf(sink) == "nil" { out line } other { sink(line) }
            give nil
        })
    }

    # ── Configuration ───────────────────────────────────────────────────────
    #
    # app.config is a plain dictionary. config_from_env pulls every variable
    # starting with `prefix` into it, lower-cased and with the prefix stripped,
    # so EZWEB_PORT becomes config["port"]. There was previously nowhere to put
    # settings but globals.
    task config_get(key, fallback = nil) {
        when has_key(self.config, key) { give self.config[key] }
        give fallback
    }

    task config_set(key, value) {
        self.config[key] = value
        give self
    }

    # Reads named variables rather than enumerating the environment: there is no
    # portable way to list it through the FFI, so the caller says what it wants.
    #   app.config_from_env("EZWEB_", ["PORT", "SECRET"])
    task config_from_env(prefix, names) {
        get n in names {
            full = str(prefix) + str(n)
            v = nil
            when __getenv != 0 { v = os_call(__getenv, "string", full) }
            when typeOf(v) == "string" and len(v) > 0 { self.config[lower(str(n))] = v }
        }
        give self.config
    }

    # Graceful shutdown. http_server_stop() closes the listener and waits for
    # in-flight handlers, but WebApp never exposed it -- there was no way to stop
    # a server short of killing the process, which also made servers untestable.
    task stop() {
        when typeOf(HttpAccelFFI.stop) != "nil" and HttpAccelFFI.stop != 0 {
            os_call(HttpAccelFFI.stop, "int")
        }
        self.running = false
    }

    task mount(prefix, router) {
        while endsWith(prefix, "/") { prefix = substr(prefix, 0, len(prefix) - 1) }
        
        rKeys = keys(router.routes)
        get rKey in rKeys {
            routeObj = router.routes[rKey]
            
            methodEnd = indexOf(rKey, "_")
            method = substr(rKey, 0, methodEnd)
            pathPatt = substr(rKey, methodEnd + 1, len(rKey) - methodEnd - 1)
            
            fullPath = prefix + pathPatt
            
            wrappedHandler = |req| {
                resObj = { "status": 200, "headers": {}, "body": "" }
                result = nil
                i_mid = 0
                while i_mid < len(router.middlewares) {
                    m_res = router.middlewares[i_mid](req, resObj)
                    when m_res != nil { result = m_res  i_mid = len(router.middlewares) }
                    other { i_mid = i_mid + 1 }
                }
                when result == nil { result = routeObj["handler"](req) }
                give result
            }
            
            self._addRoute(method, fullPath, wrappedHandler)
        }
    }
    
    # NOTE: the parameter list here mirrors the EZCallback typedef in
    # src/http_accel.cpp exactly. libffi marshals by that shape, so the two must
    # always be changed together -- a mismatch corrupts the stack instead of
    # failing cleanly.
    task _handleCallback(req_id, method, path, query_json, headers_json, body, client_ip) {
        # Built BEFORE the try so that the catch below (and any on_500 handler)
        # still has a usable request to report on -- anything declared inside the
        # try is out of scope in the catch.
        req = {}
        req["id"] = req_id
        req["method"] = method
        req["path"] = path
        req["fullPath"] = path
        req["body"] = body
        # Real peer address from accept(), so handlers and the rate limiter can
        # finally tell clients apart.
        req["ip"] = client_ip
        req["headers"] = {}
        req["query"] = {}
        req["form"] = {}
        req["files"] = {}
        req["params"] = {}
        req["cookies"] = {}
        req["session"] = {}

        try {
            when self.debug { out "[ez.web] " + method + " " + path + " from " + str(client_ip) }
            # form/params/cookies/session were initialised above, before the try.
            req["headers"] = parse_json(headers_json)
            req["query"] = parse_json(query_json)

            headers = req["headers"]
            inst = self

            # Repair a body that lost bytes crossing the FFI.
            #
            # `body` arrives as a C string, so it ends at the first NUL. Compare
            # what we got against the declared Content-Length: if they disagree,
            # the body was binary and got cut short, so pull the real bytes over
            # by pointer+length. Text requests -- the overwhelming majority --
            # match on the first check and pay nothing.
            #
            # Doing this here means req["body"], req["form"] and req["files"] are
            # all built from the true bytes, so file uploads finally work for
            # binary formats.
            when has_key(headers, "content-length") {
                # num() raises on a non-numeric string rather than returning nil,
                # and Content-Length is client-supplied, so guard it.
                declared = -1
                try { declared = num(str(headers["content-length"])) } catch (ce) { declared = -1 }
                when declared > 0 and len(body) != declared {
                    raw = request_body_raw(req)
                    when len(raw) > len(body) { body = raw }
                }
            }
            req["body"] = body

            when has_key(headers, "content-type") {
                cType = headers["content-type"]
                when indexOf(cType, "application/x-www-form-urlencoded") != -1 {
                    fPairs = split(body, "&")
                    get pair in fPairs {
                        eIdx = indexOf(pair, "=")
                        when eIdx != -1 { req["form"][WebUtils.decodeUrl(substr(pair, 0, eIdx))] = WebUtils.decodeUrl(substr(pair, eIdx + 1, len(pair) - (eIdx + 1))) }
                        other { req["form"][WebUtils.decodeUrl(pair)] = true }
                    }
                } other when indexOf(cType, "multipart/form-data") != -1 {
                    bIdx = indexOf(cType, "boundary=")
                    when bIdx != -1 {
                        boundary = "--" + substr(cType, bIdx + 9, len(cType) - (bIdx + 9))
                        parts = split(body, boundary)
                        get p in parts {
                            headEnd = indexOf(p, "\r\n\r\n")
                            when headEnd != -1 {
                                pHead = substr(p, 0, headEnd)
                                pBody = substr(p, headEnd + 4, len(p) - (headEnd + 4) - 2)
                                nIdx = indexOf(pHead, "name=\"")
                                when nIdx != -1 {
                                    nEnd = indexOfSafe(pHead, "\"", nIdx + 6)
                                    fieldName = substr(pHead, nIdx + 6, nEnd - (nIdx + 6))
                                    req["form"][fieldName] = pBody

                                    # A part carrying filename="..." is an uploaded
                                    # FILE, not a plain field. The filename and
                                    # Content-Type were sitting in the part header
                                    # and thrown away, so there was no way to tell
                                    # an upload from a text field, or to know what
                                    # was actually sent. Surface them in req["files"].
                                    fIdx = indexOf(pHead, "filename=\"")
                                    when fIdx != -1 {
                                        fEnd = indexOfSafe(pHead, "\"", fIdx + 10)
                                        upName = substr(pHead, fIdx + 10, fEnd - (fIdx + 10))
                                        upType = "application/octet-stream"
                                        ctIdx = indexOf(pHead, "Content-Type:")
                                        when ctIdx != -1 {
                                            ctEnd = indexOfSafe(pHead, "\r\n", ctIdx)
                                            when ctEnd == -1 { ctEnd = len(pHead) }
                                            upType = trim(substr(pHead, ctIdx + 13, ctEnd - (ctIdx + 13)))
                                        }
                                        req["files"][fieldName] = {
                                            "filename": upName,
                                            "contentType": upType,
                                            "size": len(pBody),
                                            "content": pBody
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            
            when has_key(headers, "cookie") {
                cPairs = split(headers["cookie"], ";")
                get pair in cPairs {
                    pair = trim(pair)
                    eIdx = indexOf(pair, "=")
                    when eIdx != -1 { req["cookies"][substr(pair, 0, eIdx)] = substr(pair, eIdx + 1, len(pair) - (eIdx + 1)) }
                }
            }
            
            sessionId = nil
            when has_key(req["cookies"], "ez_session") {
                sessionId = req["cookies"]["ez_session"]
                sData = inst.sessionStore.get(sessionId)
                when sData != nil {
                    hKeys = keys(sData)
                    get hk in hKeys { req["session"][hk] = sData[hk] }
                }
            }
            
            handled = false
            routeKeys = keys(inst.routes)
            matchedRoute = nil
            reqParts = split(req["path"], "/")

            # Pick the MOST SPECIFIC matching route, not simply the first one
            # found. routeKeys comes from keys() over a dictionary, which is hash
            # order, not registration order -- so "first match wins" made routing
            # depend on hashing. In practice "/users/<id>" hashes ahead of
            # "/users/new", so GET /users/new matched the parameterised route with
            # id="new" and the static route was unreachable.
            #
            # Scoring by the number of literal segments makes a static segment
            # always beat a parameter, which is what every routing framework
            # promises, and makes the outcome independent of hash order.
            found = inst._matchRoute(method, reqParts)

            # HEAD must answer exactly as GET does, minus the body. Without this
            # a GET-only route 405s on HEAD, which breaks link checkers, caches
            # and anything probing for a resource's existence -- and meant every
            # route had to be registered twice to be correct.
            headOnly = false
            when typeOf(found) == "nil" and method == "HEAD" and inst.auto_head {
                found = inst._matchRoute("GET", reqParts)
                when typeOf(found) != "nil" { headOnly = true }
            }

            when typeOf(found) != "nil" {
                matchedRoute = found["route"]
                req["params"] = found["params"]
            }

            resObj = { "status": 200, "headers": {}, "body": "" }

            when matchedRoute != nil {
                handled = true
                result = nil
                i_mid = 0
                while i_mid < len(inst.middlewares) {
                    m_res = inst.middlewares[i_mid](req, resObj)
                    when m_res != nil { result = m_res  i_mid = len(inst.middlewares) }
                    other { i_mid = i_mid + 1 }
                }
                
                when result == nil { result = matchedRoute["handler"](req) }

                # The handler streamed its own response (stream_begin/write/end),
                # so the socket is already answered. Returning here is what stops
                # the framework appending a second, complete HTTP response after
                # the chunked one.
                when typeOf(result) == "string" and result == STREAMED { give nil }

                # Binary/file responses stream from C++ (see WebUtils.isBinaryType).
                # A handler returns {"__sendfile__": "<path>"} -- or calls
                # send_file() -- and the bytes never pass through an EZ string, so
                # NULs survive and large files are not copied into memory.
                when typeOf(result) == "dictionary" and has_key(result, "__sendfile__") {
                    fpath = str(result["__sendfile__"])
                    fsize = os_call(HttpAccelFFI.fileSize, "int", fpath)
                    when fsize < 0 {
                        fb = "<h1>404 Not Found</h1>"
                        fLen = os_call(WebFFI.strlenFunc, "int", fb)
                        fResp = "HTTP/1.1 404 Not Found\r\nServer: EZ Web Framework\r\nConnection: close\r\nContent-Type: text/html\r\nContent-Length: " + str(fLen) + "\r\n\r\n" + fb
                        os_call(HttpAccelFFI.respond, "int", req["id"], fResp, len(fResp))
                        give nil
                    }
                    fh = resObj["headers"]
                    when has_key(result, "headers") {
                        rh = result["headers"]
                        get hk in keys(rh) { fh[hk] = rh[hk] }
                    }
                    when not has_key(fh, "Content-Type") { fh["Content-Type"] = WebUtils.contentTypeFor(fpath) }

                    # A range was negotiated: 206 with only the requested slice.
                    when has_key(result, "__range__") {
                        rg = result["__range__"]
                        rhdr = "HTTP/1.1 206 Partial Content\r\nServer: EZ Web Framework\r\nConnection: close\r\n"
                        rhdr = rhdr + emitHeaderLines(fh)
                        rhdr = rhdr + "Content-Length: " + str(rg["length"]) + "\r\n\r\n"
                        when self.debug { out "[ez.web] sendfile range " + fpath + " " + str(rg["start"]) + "-" + str(rg["end"]) }
                        os_call(HttpAccelFFI.sendFileRange, "int", req["id"], rhdr, fpath, rg["start"], rg["length"])
                        give nil
                    }

                    fhdr = "HTTP/1.1 200 OK\r\nServer: EZ Web Framework\r\nConnection: close\r\n"
                    fhdr = fhdr + emitHeaderLines(fh)
                    fhdr = fhdr + "Content-Length: " + str(fsize) + "\r\n\r\n"
                    when self.debug { out "[ez.web] sendfile " + fpath + " (" + str(fsize) + " bytes)" }
                    os_call(HttpAccelFFI.sendFile, "int", req["id"], fhdr, fpath)
                    give nil
                }

                t = typeOf(result)
                b = ""
                status = 200
                h = resObj["headers"]
                
                when t == "string" {
                    b = result
                    # A handler returning a bare string got NO Content-Type at all
                    # -- only the catch-all `other` branch below set one. Browsers
                    # were left to sniff the type, and gzip skipped the response
                    # because it could not tell whether it was compressible.
                    when not has_key(h, "Content-Type") { h["Content-Type"] = "text/html; charset=utf-8" }
                }
                other when t == "dictionary" or t == "dict" {
                    when has_key(result, "status") { status = result["status"] }
                    when has_key(result, "body") { 
                        bd = result["body"]
                        when typeOf(bd) == "dictionary" or typeOf(bd) == "array" or typeOf(bd) == "dict" {
                            b = to_json(bd)
                            h["Content-Type"] = "application/json"
                        } other { b = str(bd) }
                    } other {
                        b = to_json(result)
                        h["Content-Type"] = "application/json"
                    }
                    when has_key(result, "headers") { 
                        hx = result["headers"]
                        hKeys = keys(hx)
                        get hk in hKeys { h[hk] = hx[hk] }
                    }
                } other when t == "array" {
                    b = to_json(result)
                    h["Content-Type"] = "application/json"
                } other {
                    b = str(result)
                    when not has_key(h, "Content-Type") { h["Content-Type"] = "text/html" }
                }
                
                when has_key(h, "Content-Type") and h["Content-Type"] == "text/html" and has_key(req["session"], "_flashes") {
                    flashes = req["session"]["_flashes"]
                    when len(flashes) > 0 {
                        flash_html = ""
                        get f in flashes {
                            cat = f["c"]
                            msg = f["m"]
                            style = "background:var(--primary-light);border-color:var(--primary);color:var(--primary);"
                            when cat == "success" { style = "background:var(--success-light);border-color:#6ee7b7;color:#065f46;" }
                            when cat == "error" or cat == "danger" { style = "background:var(--danger-light);border-color:#fca5a5;color:#991b1b;" }
                            # Escape the message: it is application-supplied and
                            # frequently derived from user input (e.g.
                            # flash(req, "No user named " + username)). It used to
                            # be interpolated raw, which made flash() a stored-XSS
                            # sink even though the template engine escapes {{ }}
                            # by default.
                            flash_html = flash_html + "<div class='alert' style='padding:1rem;margin-bottom:1rem;border:1px solid;border-radius:0.5rem;" + style + "'>" + WebUtils.escapeHtml(msg) + "</div>"
                        }
                        req["session"]["_flashes"] = []
                        
                        bIdx = indexOf(b, "<body")
                        when bIdx != -1 {
                            bEnd = indexOfSafe(b, ">", bIdx)
                            when bEnd != -1 {
                                b = substr(b, 0, bEnd + 1) + "<div style='max-width:1200px;margin:1rem auto;padding:0 1.5rem;'>" + flash_html + "</div>" + substr(b, bEnd + 1, len(b) - (bEnd + 1))
                            }
                        }
                    }
                }
                
                # regenerate_session() asked for a fresh id: retire the old one
                # server-side (so a fixed/stolen id stops working) and fall
                # through to minting a new one below.
                when has_key(req, "__regenerate_session__") and req["__regenerate_session__"] {
                    when sessionId != nil { inst.sessionStore.delete(sessionId) }
                    sessionId = nil
                    dictRemove(req, "__regenerate_session__")
                    # The old cookie must be replaced, not kept.
                    when has_key(h, "Set-Cookie") { dictRemove(h, "Set-Cookie") }
                }

                sKeys = keys(req["session"])
                when len(sKeys) > 0 {
                    when sessionId == nil {
                        # Session ids MUST be unguessable: anyone who can predict
                        # one can hijack that session by sending it as a cookie.
                        # This used to be "sess_" + clock() + "_" + counter --
                        # a millisecond timestamp plus a small integer, which an
                        # attacker can simply enumerate.
                        inst.sessionCounter = inst.sessionCounter + 1
                        sessionId = "sess_" + secure_token(32)
                    }
                    inst.sessionStore.set(sessionId, req["session"])
                    # SameSite=Lax stops the cookie riding along on cross-site
                    # form posts (CSRF) while still surviving normal navigation.
                    #
                    # Max-Age matches the store's TTL so the two agree on when a
                    # session is over. Without it this was a pure session cookie:
                    # it outlived the server-side record whenever the browser
                    # stayed open, and the browser kept presenting an id the
                    # store had already expired.
                    #
                    # Appended, not guarded on "is Set-Cookie absent". The old
                    # check skipped the session cookie entirely whenever the
                    # handler had set any cookie of its own, so calling
                    # set_cookie() anywhere in a request quietly dropped the
                    # session and logged the user out on the next click.
                    cookie = "ez_session=" + sessionId + "; Path=/; HttpOnly; SameSite=Lax"
                    when inst.sessionTTL > 0 { cookie = cookie + "; Max-Age=" + str(inst.sessionTTL) }
                    addHeader(h, "Set-Cookie", cookie)
                }
                
                # after_request hooks. Run for matched routes here and for
                # 404/405/500 further down, so "every response" really means
                # every response. A hook may mutate res in place or return a
                # replacement.
                aRes = { "status": status, "headers": h, "body": b }
                get af in inst.afterHooks {
                    replaced = af(req, aRes)
                    when typeOf(replaced) == "dictionary" { aRes = replaced }
                }
                status = aRes["status"]
                h = aRes["headers"]
                b = str(aRes["body"])

                statusPhrase = "OK"
                when has_key(WebUtils.HTTP_STATUS, status) { statusPhrase = WebUtils.HTTP_STATUS[status] }

                respChunks = ["HTTP/1.1 ", str(status), " ", statusPhrase, "\r\n"]
                when not has_key(h, "Server") { h["Server"] = "EZ Web Framework" }
                # Honour HTTP/1.1's persistent-connection default instead of
                # hardcoding "close" on every response, which forced a fresh TCP
                # handshake (and a fresh server thread) for every single request.
                # The C++ side treats this header as the source of truth for
                # whether to reuse the socket.
                when not has_key(h, "Connection") {
                    h["Connection"] = "close"
                    when inst.keep_alive and not WebUtils.wantsClose(req) { h["Connection"] = "keep-alive" }
                }
                
                push(respChunks, emitHeaderLines(h))

                byteLen = os_call(WebFFI.strlenFunc, "int", b)
                push(respChunks, "Content-Length: ")
                push(respChunks, str(byteLen))
                push(respChunks, "\r\n\r\n")
                # HEAD answered from a GET route: send the headers the GET would
                # have sent, including its Content-Length, but no body. The
                # length must describe what a GET WOULD return, which is why it
                # is computed before the body is dropped.
                when not headOnly { push(respChunks, b) }


                respStr = join(respChunks, "")
                when self.debug { out "[ez.web] " + str(status) + " -> " + str(len(respStr)) + " bytes" }
                os_call(HttpAccelFFI.respond, "int", req["id"], respStr, len(respStr))
            }
            
            when not handled {
                # Middleware used to run ONLY when a route matched, so nothing in
                # the chain ever saw a request that fell through to 404/405. That
                # made a CORS preflight impossible to answer: OPTIONS /thing has
                # no registered OPTIONS route, so the request went straight to
                # 405 and useCORS() never got a look at it. Auth and logging
                # middleware were equally blind to every 404.
                #
                # Run the chain here as well, and honour a short-circuit
                # response. Matched requests are untouched -- they still run the
                # chain in the branch above, exactly once.
                mwRes = nil
                i_mid = 0
                while i_mid < len(inst.middlewares) {
                    m_res = inst.middlewares[i_mid](req, resObj)
                    when m_res != nil { mwRes = m_res  i_mid = len(inst.middlewares) }
                    other { i_mid = i_mid + 1 }
                }
                when typeOf(mwRes) == "dictionary" {
                    mStatus = 200
                    when has_key(mwRes, "status") { mStatus = mwRes["status"] }
                    mBody = ""
                    when has_key(mwRes, "body") { mBody = str(mwRes["body"]) }
                    mHdrs = resObj["headers"]
                    when has_key(mwRes, "headers") {
                        rh = mwRes["headers"]
                        get hk in keys(rh) { mHdrs[hk] = rh[hk] }
                    }
                    mPhrase = "OK"
                    when has_key(WebUtils.HTTP_STATUS, mStatus) { mPhrase = WebUtils.HTTP_STATUS[mStatus] }
                    mResp = "HTTP/1.1 " + str(mStatus) + " " + mPhrase + "\r\nServer: EZ Web Framework\r\nConnection: close\r\n"
                    mResp = mResp + emitHeaderLines(mHdrs)
                    # A 204 carries no body, and RFC 7230 says not to advertise a
                    # length for one.
                    when mStatus != 204 {
                        mResp = mResp + "Content-Length: " + str(os_call(WebFFI.strlenFunc, "int", mBody)) + "\r\n"
                    }
                    mResp = mResp + "\r\n" + mBody
                    when self.debug { out "[ez.web] " + str(mStatus) + " -> middleware short-circuit" }
                    os_call(HttpAccelFFI.respond, "int", req["id"], mResp, len(mResp))
                    give nil
                }

                # Trailing-slash tolerance. /users/ and /users split into
                # different segment counts, so registering one and requesting the
                # other used to 404 with nothing explaining why. If the other
                # spelling exists, redirect to it -- 308, which (unlike 301/302)
                # browsers must replay with the SAME method and body, so a POST
                # to /submit/ is not silently downgraded to a GET of /submit.
                when not inst.strict_slashes {
                    altPath = nil
                    p0 = req["path"]
                    when len(p0) > 1 and endsWith(p0, "/") { altPath = substr(p0, 0, len(p0) - 1) }
                    other when p0 != "/" { altPath = p0 + "/" }
                    when typeOf(altPath) != "nil" {
                        altHit = inst._matchRoute(method, split(altPath, "/"))
                        when typeOf(altHit) != "nil" {
                            # Carry the query across. The raw query string is not
                            # kept on req (only the parsed dictionary), so it is
                            # rebuilt and re-encoded here -- dropping it would
                            # turn "/search/?q=x" into a redirect that loses the
                            # search term.
                            loc = altPath
                            qKeys = keys(req["query"])
                            when len(qKeys) > 0 {
                                qs = ""
                                get qk in qKeys {
                                    when qs != "" { qs = qs + "&" }
                                    qs = qs + WebUtils.encodeUrl(str(qk)) + "=" + WebUtils.encodeUrl(str(req["query"][qk]))
                                }
                                loc = loc + "?" + qs
                            }
                            rResp = "HTTP/1.1 308 Permanent Redirect\r\nServer: EZ Web Framework\r\nConnection: close\r\nLocation: " + loc + "\r\nContent-Length: 0\r\n\r\n"
                            os_call(HttpAccelFFI.respond, "int", req["id"], rResp, len(rResp))
                            give nil
                        }
                    }
                }

                # 405 vs 404: if the path matches a route registered under a
                # DIFFERENT method, that is "Method Not Allowed", not "Not Found".
                # Reporting 404 here hid the real mistake (e.g. posting to a
                # GET-only route looked like a missing route).
                allowed = inst._allowedMethodsFor(reqParts)
                status404 = 404
                when len(allowed) > 0 { status404 = 405 }

                # Honour the handler registered via on_404()/on_error(). This used
                # to be hardcoded HTML: errorHandlers was written by on_404()/
                # on_500() and then never read anywhere, so both were silently
                # no-ops even though the README documents them.
                #
                # Looked up by the ACTUAL status, so on_error(405, ...) works too
                # -- previously only 404 could ever be customised.
                b = ""
                errHdrs = {}
                when status404 == 405 { errHdrs["Allow"] = join(allowed, ", ") }
                custom = nil
                when has_key(inst.errorHandlers, str(status404)) { custom = inst.errorHandlers[str(status404)] }
                when typeOf(custom) != "nil" {
                    cres = custom(req)
                    when typeOf(cres) == "dictionary" {
                        when has_key(cres, "status") { status404 = cres["status"] }
                        when has_key(cres, "body") { b = str(cres["body"]) } other { b = "" }
                        when has_key(cres, "headers") {
                            ch = cres["headers"]
                            get hk in keys(ch) { errHdrs[hk] = ch[hk] }
                        }
                    } other { b = str(cres) }
                } other {
                    b = "<h1>404 Not Found</h1>"
                    when status404 == 405 { b = "<h1>405 Method Not Allowed</h1>" }
                }
                when not has_key(errHdrs, "Content-Type") { errHdrs["Content-Type"] = "text/html" }

                # after_request runs on error responses too.
                aRes = { "status": status404, "headers": errHdrs, "body": b }
                get af in inst.afterHooks {
                    replaced = af(req, aRes)
                    when typeOf(replaced) == "dictionary" { aRes = replaced }
                }
                status404 = aRes["status"]
                errHdrs = aRes["headers"]
                b = str(aRes["body"])

                phrase = "Not Found"
                when has_key(WebUtils.HTTP_STATUS, status404) { phrase = WebUtils.HTTP_STATUS[status404] }
                byteLen = os_call(WebFFI.strlenFunc, "int", b)
                respStr = "HTTP/1.1 " + str(status404) + " " + phrase + "\r\nServer: EZ Web Framework\r\nConnection: close\r\n" + emitHeaderLines(errHdrs) + "Content-Length: " + str(byteLen) + "\r\n\r\n" + b
                when self.debug { out "[ez.web] " + str(status404) + " -> " + str(len(respStr)) + " bytes" }
                os_call(HttpAccelFFI.respond, "int", req["id"], respStr, len(respStr))
            }
        } catch e {
            # A handler that throws MUST still answer the socket. The C++ side
            # keeps the connection in g_active_sockets and holds g_active_handlers
            # up until http_server_respond() is called for this req_id, so simply
            # logging here leaked the socket AND the handler slot -- and
            # http_server_stop() waits on g_active_handlers, so it would hang
            # forever. Send a 500 so the client sees a real error and the C++ side
            # can reclaim the connection.
            out "ERROR in _handleCallback: " + str(e)
            try {
                # Honour on_500() if one is registered -- like on_404() this was
                # stored and never consulted.
                eb = "<h1>500 Internal Server Error</h1>"
                h500 = self.errorHandlers["500"]
                when typeOf(h500) != "nil" {
                    try {
                        cres = h500(req, e)
                        when typeOf(cres) == "dictionary" and has_key(cres, "body") { eb = str(cres["body"]) }
                        other { eb = str(cres) }
                    } catch e3 {
                        # A broken error handler must not stop us answering.
                        out "ERROR in on_500 handler: " + str(e3)
                    }
                }
                eLen = os_call(WebFFI.strlenFunc, "int", eb)
                eResp = "HTTP/1.1 500 Internal Server Error\r\nServer: EZ Web Framework\r\nConnection: close\r\nContent-Type: text/html\r\nContent-Length: " + str(eLen) + "\r\n\r\n" + eb
                os_call(HttpAccelFFI.respond, "int", req_id, eResp, len(eResp))
            } catch e2 {
                out "ERROR sending 500: " + str(e2)
            }
        }
    }
    
    # workers > 1 runs the prefork model: this same script is re-executed in that
    # many child processes, each with its own VM, all accepting on one inherited
    # listening socket. That is the only way handlers actually run in parallel --
    # EZ handlers are serialized on the interpreter's single main thread, so more
    # threads in one process buy nothing. See "Worker Processes" in the README for
    # what stops being shared once you do this (in-memory sessions, most notably).
    task run(port, workers = 1) {
        cb = |req_id, method, path, query_json, headers_json, body, client_ip| {
            self._handleCallback(req_id, method, path, query_json, headers_json, body, client_ip)
        }
        # Must match EZCallback in src/http_accel.cpp exactly (7 args, trailing
        # client_ip). libffi marshals by this list; a mismatch corrupts the stack.
        self.__cb_ref = os_ffi_create_callback(["int", "string", "string", "string", "string", "string", "string"], "void", cb)

        # typeOf() reports "integer"/"float" -- there is no "number".
        when typeOf(workers) != "integer" and typeOf(workers) != "float" { workers = 1 }
        when workers < 1 { workers = 1 }

        # Workers re-run this whole script, so without this check every one of
        # them would print the banner again.
        when os_call(HttpAccelFFI.isWorker, "int") != 1 {
            out "==================================================="
            out " EZ Web Framework (C++ Accel Callback Mode) "
            out " Listening natively on http://localhost:" + str(port)
            when workers > 1 { out " Workers: " + str(workers) + " processes" }
            out "==================================================="
        }

        res = os_call(HttpAccelFFI.start, "int", port, self.__cb_ref, workers)
        # 2 = this process was the supervisor and every worker has now exited.
        when res == 2 { give nil }
        when res != 1 {
            out "Failed to start C++ HTTP Accel server"
            give nil
        }
        
        # Park the main thread while the C++ accelerator serves requests on its
        # own threads and drives us through the FFI callback.
        #
        # The fallback used to be `while true { }` -- a bare spin that pins a CPU
        # core at 100% for the entire life of the server. Sleep() is part of
        # kernel32 and is loaded at the top of this file, so if it is somehow
        # missing, block on a plain wait() rather than burning a core.
        when typeOf(__sleep) != "nil" and __sleep != 0 {
            while true {
                fut = waitAsync(10000)
                await(fut)
            }
        } other {
            while true { wait(1000) }
        }
    }
}
