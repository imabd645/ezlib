// ============================================================================
// thread — Concurrency helpers for EZ
//
//   use "thread"
//
//   results = parallelMap([1, 2, 3], | n | { give n * 2 })
//
//   pool = WorkerPool(4)
//   pool.mapAll(urls, fetchOne)          # never more than 4 in flight
//
// ── Use the interpreter directly for the basics ─────────────────────────────
//
// These are builtins. This package deliberately does NOT wrap them, and the
// wrappers that used to duplicate them have been removed:
//
//     spawn(fn, args...)     start work on a thread -> future
//     await(f) / sync(f)     wait for one future
//     awaitAll(futures)      wait for all, results in order   (was: all)
//     awaitAny(futures)      first to settle                  (was: race)
//     isDone(f)              has it finished, without blocking
//     cancel(f)              cancel a future
//     wait(ms)               sleep                            (was: sleep/delay)
//     mutex() / lock(m, fn)  mutual exclusion                 (was: Mutex)
//     Channel()              blocking queue                   (was: Channel)
//     Atomic(v)              atomic counter
//
// The removed versions were not merely redundant. The old Mutex and Semaphore
// did `while locked { wait(1) }` and then set the flag as a separate step, so
// two threads could pass the check together and both take the lock -- no
// mutual exclusion at all, and a WorkerPool that did not bound anything. The
// old Channel was an unsynchronised array polled on a timer. The native ones
// are real mutexes and condition variables.
// ============================================================================

use "errors.ez"
use "sync.ez"
use "futures.ez"
use "parallel.ez"
use "rate.ez"

// How many of these futures are still running. Cheap and non-blocking, for
// progress reporting.
export task pending(futures) {
    n = 0
    get f in futures {
        when not isDone(f) { n = n + 1 }
    }
    give n
}

// Results of whichever futures have already finished, skipping the rest.
// Never blocks.
export task settledSoFar(futures) {
    done = []
    get f in futures {
        when isDone(f) {
            try {
                push(done, {"ok": true, "value": await(f), "error": nil})
            } catch (e) {
                push(done, {"ok": false, "value": nil, "error": str(e)})
            }
        }
    }
    give done
}
