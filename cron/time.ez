# ============================================================================
# cron/time.ez — calendar arithmetic, in integers
#
# A schedule needs to go from a unix timestamp to a date and back, exactly, for
# any year. Doing that by adding days and carrying is where leap years get lost,
# so the conversion here is Howard Hinnant's civil-days algorithm: closed-form
# integer arithmetic, correct across leap years and centuries with no table and
# no accumulated error.
#
# Everything is UTC. See the README for why local time with DST is not
# attempted.
# ============================================================================

DAYS_IN_MONTH = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]

# Integer division that floors, including for negative numerators -- which is
# what the algorithm below assumes and what `/` does not give.
export task idiv(a, b) { give floor(a / b) }

export task isLeapYear(year) {
    when year % 4 != 0 { give false }
    when year % 100 != 0 { give true }
    give year % 400 == 0
}

export task daysInMonth(year, month) {
    when month == 2 and isLeapYear(year) { give 29 }
    give DAYS_IN_MONTH[month - 1]
}

# Days since 1970-01-01 for a proleptic Gregorian date.
export task daysFromCivil(year, month, day) {
    y = year
    when month <= 2 { y = y - 1 }
    era = idiv(y, 400)
    yoe = y - era * 400
    shifted = month - 3
    when month <= 2 { shifted = month + 9 }
    doy = idiv(153 * shifted + 2, 5) + day - 1
    doe = yoe * 365 + idiv(yoe, 4) - idiv(yoe, 100) + doy
    give era * 146097 + doe - 719468
}

export task civilFromDays(days) {
    z = days + 719468
    era = idiv(z, 146097)
    doe = z - era * 146097
    yoe = idiv(doe - idiv(doe, 1460) + idiv(doe, 36524) - idiv(doe, 146096), 365)
    y = yoe + era * 400
    doy = doe - (365 * yoe + idiv(yoe, 4) - idiv(yoe, 100))
    mp = idiv(5 * doy + 2, 153)
    d = doy - idiv(153 * mp + 2, 5) + 1
    m = mp + 3
    when mp >= 10 { m = mp - 9 }
    when m <= 2 { y = y + 1 }
    give { "year": y, "month": m, "day": d }
}

# 0 = Sunday, matching the cron field.
export task weekdayFromDays(days) {
    when days >= -4 { give (days + 4) % 7 }
    give ((days + 5) % 7) + 6
}

# A unix timestamp into its parts.
export task breakDown(epochSeconds) {
    whole = floor(epochSeconds)
    days = idiv(whole, 86400)
    secondOfDay = whole - days * 86400
    date = civilFromDays(days)
    date["hour"] = idiv(secondOfDay, 3600)
    date["minute"] = idiv(secondOfDay % 3600, 60)
    date["second"] = secondOfDay % 60
    date["weekday"] = weekdayFromDays(days)
    date["days"] = days
    give date
}

export task buildUp(year, month, day, hour, minute, second) {
    give daysFromCivil(year, month, day) * 86400 + hour * 3600 + minute * 60 + second
}

export task startOfDay(days) { give days * 86400 }

export task pad2(value) {
    when value < 10 { give "0" + str(value) }
    give str(value)
}

# ISO 8601, so a schedule can be printed without pulling in a date library.
export task formatTime(epochSeconds) {
    p = breakDown(epochSeconds)
    give `{p["year"]}-{pad2(p["month"])}-{pad2(p["day"])}T{pad2(p["hour"])}:{pad2(p["minute"])}:{pad2(p["second"])}Z`
}

export task nowSeconds() { give floor(clock() / 1000) }
