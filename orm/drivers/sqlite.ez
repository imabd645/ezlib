// ============================================================================
// EZ ORM — SQLite driver
//
// This used to carry its own copy of the SQLite C binding: twenty-three
// os_get_func calls, its own handle, its own binder and its own row reader.
// That was the third such copy in the registry, alongside the `sqlite` package
// and `db`. It sits on `sqlite` now, and the duplicate binding is gone.
//
// What is kept is the part that belongs to an ORM rather than to SQLite: the
// prepared-statement cache. An ORM issues the same handful of statements over
// and over, and prepare re-parses and re-plans on every call.
//
// What is gained by not doing the binding here:
//
//   * No DLL to install. This needed sqlite3.dll or libsqlite3-0.dll on the
//     path; `sqlite` falls back to winsqlite3.dll, which Windows ships.
//   * A stricter value boundary for free. `sqlite`'s binder also handles named
//     parameters, rejects a statement that mixes named and positional styles,
//     and refuses to bind a dictionary rather than storing "<dictionary>".
//   * The multi-statement guard, the type mapping and the error text are one
//     implementation instead of three that can drift apart.
// ============================================================================

use "orm/errors.ez"
use "orm/sql.ez"
use "sqlite"

export model SQLiteDriver {
    init(path, busyTimeoutMs = 5000, cacheSize = 64) {
        // Every driver must declare its dialect; the engine reads this to pick
        // type mappings and identifier quoting. Its absence here used to make
        // the engine fall back to sqlite by accident rather than by design.
        self.dialect = "sqlite"
        self.path = path

        // WAL, foreign keys and the busy timeout were three separate steps
        // after opening; `sqlite` applies them as part of opening.
        self._db = nil
        try {
            self._db = connect(path, {
                "busy_timeout": busyTimeoutMs,
                "wal": true,
                "foreign_keys": true
            })
        }
        catch (e) {
            throw DriverError("Failed to open database '" + str(path) + "': " + causeOf(e))
        }

        // Statements are REMOVED from the cache while in use, so a re-entrant
        // call with the same SQL prepares a second one rather than sharing
        // (and corrupting) a statement that is mid-iteration.
        self._cache = {}
        self._cacheOrder = []
        self._cacheSize = cacheSize
    }

    // ── Driver interface ──────────────────────────────────────────

    task execute(sql, params) {
        stmt = self._acquire(sql)
        try {
            stmt.bind(params)
            stmt.next()
        }
        catch (e) {
            // Released on the failure path too. `finally` is not used: it does
            // not run when a `give` leaves the block in this language, and a
            // leaked statement holds an open read transaction, which under WAL
            // blocks checkpointing indefinitely.
            self._release(sql, stmt)
            throw DriverError("Execute failed for SQL '" + str(sql) + "': " + causeOf(e))
        }
        self._release(sql, stmt)
        give nil
    }

    task query(sql, params) {
        stmt = self._acquire(sql)
        results = []
        try {
            stmt.bind(params)
            while stmt.next() { push(results, stmt.row_dict()) }
        }
        catch (e) {
            self._release(sql, stmt)
            throw DriverError("Query failed for SQL '" + str(sql) + "': " + causeOf(e))
        }
        self._release(sql, stmt)
        give results
    }

    task lastInsertId() { give self._db.last_insert_id() }

    task changes() { give self._db.changes() }

    task begin() { self._db.exec("BEGIN TRANSACTION") }
    task commit() { self._db.exec("COMMIT") }
    task rollback() { self._db.exec("ROLLBACK") }

    task close() {
        when self._db != nil and self._db.is_closed() == false {
            // A connection will not close while any statement is still live,
            // so the cache is drained first.
            self._flushCache()
            self._db.close()
        }
        give nil
    }

    // ── Statement cache ───────────────────────────────────────────

    // A ready-to-bind statement for this SQL, prepared only on a cache miss.
    task _acquire(sql) {
        when has_key(self._cache, sql) {
            cached = self._cache[sql]
            dictRemove(self._cache, sql)
            idx = indexOf(self._cacheOrder, sql)
            when idx != -1 { remove(self._cacheOrder, idx) }
            cached.reset(true)
            give cached
        }
        // prepare compiles only the FIRST statement of a multi-statement string
        // and silently ignores the rest -- a data-integrity trap, so it is
        // refused rather than half-run.
        when hasMultipleStatements(sql) {
            throw DriverError("Multiple SQL statements passed in one call; only the first would run. Split them into separate execute() calls. SQL: '" + str(sql) + "'")
        }
        try { give self._db.prepare(sql) }
        catch (e) { throw DriverError("Prepare failed for SQL '" + str(sql) + "': " + causeOf(e)) }
    }

    // Returns a statement to the cache, or finalizes it when the cache is full.
    task _release(sql, stmt) {
        when stmt == nil { give nil }

        when self._cacheSize <= 0 {
            stmt.finalize()
            give nil
        }
        when has_key(self._cache, sql) {
            // A re-entrant call already re-cached this SQL; finalize the spare
            // rather than leaking it.
            stmt.finalize()
            give nil
        }
        // Evict the oldest statement when at capacity.
        when len(self._cacheOrder) >= self._cacheSize {
            oldest = self._cacheOrder[0]
            remove(self._cacheOrder, 0)
            when has_key(self._cache, oldest) {
                self._cache[oldest].finalize()
                dictRemove(self._cache, oldest)
            }
        }
        stmt.reset(true)
        self._cache[sql] = stmt
        push(self._cacheOrder, sql)
        give nil
    }

    task _flushCache() {
        get k in keys(self._cache) { self._cache[k].finalize() }
        self._cache = {}
        self._cacheOrder = []
        give nil
    }
}

// str(e) on an EZ exception renders "<instance>", which throws away the only
// part worth reading. The message lives on .message.
task causeOf(e) {
    when hasattr(e, "message") { give str(getattr(e, "message")) }
    give str(e)
}
