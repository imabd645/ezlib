// ============================================================================
// EZ ORM — PostgreSQL driver
//
// This used to carry its own libpq binding, the second in the registry
// alongside the `postgres` package. It sits on that package now.
//
// The important part of the change is not the deduplication. The old driver
// did not bind parameters at all: it rendered each value into the SQL text
// with PQescapeLiteral and sent the finished string to PQexec. Escaping is a
// weaker guarantee than binding -- it depends on getting every type, every
// encoding and every edge case right, and it is the mechanism behind most SQL
// injection that survives a "we escape our inputs" review.
//
// `postgres` sends values through PQexecParams, so they travel beside the
// statement instead of inside it and are never parsed as SQL. A `?` in orm's
// generated SQL becomes a real $1 placeholder here.
//
// Also inherited from that package, rather than reimplemented: SQLSTATE-aware
// errors (so callers can branch on the code instead of matching message text),
// the full type map, and NULL handling that is distinct from empty string.
// ============================================================================

use "orm/errors.ez"
use "orm/sql.ez"
use "postgres"

export model PostgresDriver {
    init(connectionString) {
        self.dialect = "postgres"
        self._lastChanges = 0
        self._pg = nil
        try {
            self._pg = Postgres(conninfoOf(connectionString))
            self._pg.open()
        }
        catch (e) {
            throw DriverError("Failed to connect to PostgreSQL: " + causeOf(e))
        }
    }

    // ── Driver interface ──────────────────────────────────────────

    task execute(sql, params) {
        try {
            result = self._pg.queryResult(self._placeholders(sql, params), params)
            self._lastChanges = result.affected
        }
        catch (e) {
            throw DriverError("Execute failed for SQL '" + str(sql) + "': " + causeOf(e))
        }
        give nil
    }

    task query(sql, params) {
        try {
            result = self._pg.queryResult(self._placeholders(sql, params), params)
            self._lastChanges = result.affected
            give result.rows
        }
        catch (e) {
            throw DriverError("Query failed for SQL '" + str(sql) + "': " + causeOf(e))
        }
    }

    task lastInsertId() {
        // Postgres has no "last insert id"; LASTVAL() returns the value most
        // recently produced by a sequence in this session, which is the id of
        // the row just inserted into a table with a SERIAL primary key. It
        // raises when no sequence has been used yet, so that is contained here
        // rather than propagated.
        try {
            value = self._pg.queryValue("SELECT LASTVAL()")
            when value != nil { give num(value) }
        }
        catch (e) { give 0 }
        give 0
    }

    task changes() { give self._lastChanges }

    task begin() { self._pg.execute("BEGIN") }
    task commit() { self._pg.execute("COMMIT") }
    task rollback() { self._pg.execute("ROLLBACK") }

    task close() {
        when self._pg != nil {
            self._pg.close()
            self._pg = nil
        }
        give nil
    }

    // ── Internals ─────────────────────────────────────────────────

    // orm generates `?` placeholders; Postgres wants $1, $2, ...
    //
    // splitPlaceholders is SQL-aware, so a `?` inside a string literal or a
    // comment is left alone. A naive replace() would renumber every later
    // parameter the first time anyone stored a question mark in a text column.
    task _placeholders(sql, params) {
        scan = splitPlaceholders(sql)
        checkArity(sql, params, scan["count"])
        when scan["count"] == 0 { give sql }

        segments = scan["segments"]
        output = []
        repeat i = 0 to scan["count"] - 1 {
            push(output, segments[i])
            push(output, "$" + str(i + 1))
        }
        push(output, segments[scan["count"]])
        give join(output, "")
    }
}

// str(e) on an EZ exception renders "<instance>", which throws away the only
// part worth reading. The message lives on .message.
task causeOf(e) {
    when hasattr(e, "message") { give str(getattr(e, "message")) }
    give str(e)
}
