// ============================================================================
// ezos / env.ez -- environment variable management.
// ============================================================================

use "ffi.ez"
use "util.ez"
use "errors.ez"

use "fs"

export model OSEnv {
    task get(key) {
        give os_call(OSFFI.getEnv, "string", str(key))
    }

    // A name that is not set comes back from getenv() as a NULL char*, which the
    // FFI marshals to the empty STRING -- never nil. Testing only for nil therefore
    // reported every name as present, including ones that were never set, and made
    // require() incapable of raising. An empty value is also exactly how Windows
    // represents "not set": SetEnvironmentVariableA with "" deletes the variable.
    task _isSet(val) {
        give typeOf(val) != "nil" and val != nil and str(val) != ""
    }

    task has(key) {
        give self._isSet(self.get(key))
    }

    task require(key) {
        val = self.get(key)
        when not self._isSet(val) {
            raise_env("Required environment variable is not set", str(key))
        }
        give val
    }

    // Sets for the current process (CRT + Win32 APIs for compatibility).
    task set(key, val) {
        key = str(key)
        val = str(val)
        os_call(OSFFI.putEnv, "int", key, val)
        os_call(OSFFI.setEnvVar, "int", key, val)
        give true
    }

    task unset(key) {
        key = str(key)
        os_call(OSFFI.putEnv, "int", key, "")
        ok = os_call(OSFFI.setEnvVar, "int", key, 0)
        give ok != 0
    }

    // Expand %VAR% and ${VAR} style references (Win32 ExpandEnvironmentStringsA).
    task expand(input) {
        src = str(input)
        buf = os_alloc(32768)
        needed = os_call(OSFFI.expandEnvStrings, "int", src, buf, 32768)
        when needed == 0 or needed > 32768 {
            os_free(buf)
            give src
        }
        output = os_read_string_ptr(buf)
        os_free(buf)
        give output
    }

    // Snapshot all environment variables as a dictionary.
    task all() {
        block = os_call(OSFFI.getEnvStrings, "ptr")
        when block == 0 { give {} }

        output= {}
        ptr = block
        while true {
            entry = os_read_string_ptr(ptr)
            when entry == "" { escape }

            eq = indexOf(entry, "=")
            when eq != -1 {
                k = substr(entry, 0, eq)
                v = substr(entry, eq + 1, len(entry) - eq - 1)
                output[k] = v
            }

            ptr = ptr + len(entry) + 1
        }

        os_call(OSFFI.freeEnvStrings, "int", block)
        give output
    }

    // Load KEY=VALUE pairs from a .env file.
    // options: { "override": true, "expand": false }
    task load(path, options = nil) {
        when isNil(path) or path == "" { path = ".env" }
        opts = ensureDict(options)

        when not exists(path) { give false }

        content = readFile(path)
        lines = split(content, "\n")
        loaded = 0

        get line in lines {
            parsed = parseEnvLine(line)
            when typeOf(parsed) != "nil" and parsed != nil {
                k = parsed["key"]
                v = parsed["value"]

                when opts["expand"] == true {
                    v = self.expand(v)
                }

                when opts["override"] == false and self.has(k) {
                    // keep existing
                } other {
                    self.set(k, v)
                    loaded = loaded + 1
                }
            }
        }

        give loaded > 0
    }

    // Merge a dictionary into the process environment.
    task merge(dict, override = true) {
        get k in keys(dict) {
            when override or not self.has(k) {
                self.set(k, dict[k])
            }
        }
        give true
    }
}
