// ============================================================================
// ezos / path.ez -- Windows path utilities.
// ============================================================================

use "ffi.ez"
use "util.ez"

export model OSPath {
    task sep() { give PATH_SEP }

    task join(p1, p2) {
        give self.joinAll([p1, p2])
    }

    task joinAll(parts) {
        when len(parts) == 0 { give "" }

        res = normalizeSlashes(str(parts[0]))
        repeat i = 1 to len(parts) - 1 {
            seg = normalizeSlashes(str(parts[i]))
            when seg != "" {
                when self.isAbsolute(seg) {
                    res = seg
                } other when endsWith(res, "\\") {
                    res = res + seg
                } other when endsWith(res, ":") {
                    res = res + "\\" + seg
                } other {
                    res = res + "\\" + seg
                }
            }
        }

        give collapseSeparators(res)
    }

    task isAbsolute(p) {
        p = str(p)
        when len(p) >= 2 and substr(p, 1, 1) == ":" { give true }
        when startsWith(p, "\\\\") { give true }
        give false
    }

    task isRelative(p) { give not self.isAbsolute(p) }

    task basename(p) {
        p = collapseSeparators(str(p))
        parts = split(p, "\\")
        give parts[len(parts) - 1]
    }

    task dirname(p) {
        p = collapseSeparators(str(p))
        parts = split(p, "\\")
        when len(parts) <= 1 { give "" }

        res = parts[0]
        repeat i = 1 to len(parts) - 2 {
            res = res + "\\" + parts[i]
        }
        give res
    }

    task extname(p) {
        base = self.basename(p)
        dot = indexOf(base, ".")
        when dot == -1 { give "" }
        give substr(base, dot, len(base) - dot)
    }

    task stem(p) {
        base = self.basename(p)
        dot = indexOf(base, ".")
        when dot == -1 { give base }
        give substr(base, 0, dot)
    }

    task normalize(p) {
        give collapseSeparators(str(p))
    }

    // Resolve relative paths against a base directory (defaults to cwd).
    task resolve(p, base = nil) {
        p = self.normalize(p)
        when self.isAbsolute(p) { give p }

        when isNil(base) or base == "" {
            buf = os_alloc(1024)
            os_call(OSFFI.getCwd, "int", 1024, buf)
            base = os_read_string_ptr(buf)
            os_free(buf)
        }

        give self.join(str(base), p)
    }
}
