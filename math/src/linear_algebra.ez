use "core.ez"
use "trigonometry.ez"

export model Vector2 {
    init(x, y) { self.x = x  self.y = y }
    task length() { give sqrt(self.x * self.x + self.y * self.y) }
    task normalize() { length = self.length()  when length == 0 { throw "Vector2.normalize(): zero vector has no direction" }  self.x = self.x / length  self.y = self.y / length  give self }
    task dot(peer) { give self.x * peer.x + self.y * peer.y }
    task distanceTo(peer) { give sqrt(pow(peer.x - self.x, 2) + pow(peer.y - self.y, 2)) }
    task angleTo(peer) { give atan2(peer.y - self.y, peer.x - self.x) }
    task lerp(peer, t) { give Vector2(self.x + (peer.x - self.x) * clamp(t, 0, 1), self.y + (peer.y - self.y) * clamp(t, 0, 1)) }
    task add(peer) { give Vector2(self.x + peer.x, self.y + peer.y) }
    task sub(peer) { give Vector2(self.x - peer.x, self.y - peer.y) }
    task mul(scalar) { give Vector2(self.x * scalar, self.y * scalar) }
    task div(scalar) { when scalar == 0 { throw "Vector2.div(): division by zero" }  give Vector2(self.x / scalar, self.y / scalar) }
}

export model Vector3 {
    init(x, y, z) { self.x = x  self.y = y  self.z = z }
    task length() { give sqrt(self.x * self.x + self.y * self.y + self.z * self.z) }
    task normalize() { length = self.length()  when length == 0 { throw "Vector3.normalize(): zero vector has no direction" }  self.x = self.x / length  self.y = self.y / length  self.z = self.z / length  give self }
    task dot(peer) { give self.x * peer.x + self.y * peer.y + self.z * peer.z }
    task cross(peer) { give Vector3(self.y * peer.z - self.z * peer.y, self.z * peer.x - self.x * peer.z, self.x * peer.y - self.y * peer.x) }
    task distanceTo(peer) { give sqrt(pow(peer.x - self.x, 2) + pow(peer.y - self.y, 2) + pow(peer.z - self.z, 2)) }
    task lerp(peer, t) { give Vector3(self.x + (peer.x - self.x) * clamp(t, 0, 1), self.y + (peer.y - self.y) * clamp(t, 0, 1), self.z + (peer.z - self.z) * clamp(t, 0, 1)) }
    task add(peer) { give Vector3(self.x + peer.x, self.y + peer.y, self.z + peer.z) }
    task sub(peer) { give Vector3(self.x - peer.x, self.y - peer.y, self.z - peer.z) }
    task mul(scalar) { give Vector3(self.x * scalar, self.y * scalar, self.z * scalar) }
    task div(scalar) { when scalar == 0 { throw "Vector3.div(): division by zero" }  give Vector3(self.x / scalar, self.y / scalar, self.z / scalar) }
}

export model Matrix2x2 {
    init(m00, m01, m10, m11) { self.m00 = m00  self.m01 = m01  self.m10 = m10  self.m11 = m11 }
    task determinant() { give self.m00 * self.m11 - self.m01 * self.m10 }
    task inverse() { determinant = self.determinant()  when abs(determinant) <= EPSILON { throw "Matrix2x2.inverse(): matrix is singular" }  give Matrix2x2(self.m11 / determinant, -self.m01 / determinant, -self.m10 / determinant, self.m00 / determinant) }
    task mulVector(vector) { give Vector2(self.m00 * vector.x + self.m01 * vector.y, self.m10 * vector.x + self.m11 * vector.y) }
}
