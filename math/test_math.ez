use "math"

failures = 0

task check(name, actual, expected) {
    when actual == expected {
        out "[PASS] " + name
    } other {
        failures = failures + 1
        out "[FAIL] " + name + " expected " + str(expected) + " got " + str(actual)
    }
}

task checkNear(name, actual, expected, tolerance = 0.000001) {
    check(name, nearlyEqual(actual, expected, tolerance), true)
}

task checkThrows(name, fn) {
    threw = false
    try { fn() } catch e { threw = true }
    check(name, threw, true)
}

checkNear("sin(pi / 2)", sin(PI / 2), 1)
checkNear("cos(pi)", cos(PI), -1)
checkNear("atan2 quadrant II", atan2(1, -1), 3 * PI / 4)
checkNear("ln(E)", ln(E), 1)
checkNear("exp(1)", exp(1), E)
check("factorial", factorial(5), 120)
check("gcd", gcd(48, 18), 6)
check("lcm", lcm(12, 18), 36)
check("prime", isPrime(97), true)
check("factors", str(factors(360)), "[2, 2, 2, 3, 3, 5]")
check("fibonacci", fibonacci(10), 55)
check("clamp", clamp(20, 0, 10), 10)
checkNear("smoothstep midpoint", smoothstep(0, 1, 0.5), 0.5)

stats = Statistics([2, 4, 4, 4, 5, 5, 7, 9])
checkNear("statistics mean", stats.mean(), 5)
checkNear("statistics median", stats.median(), 4.5)
checkNear("statistics standard deviation", stats.stddev(), 2)
checkNear("statistics percentile", stats.percentile(75), 5.5)

v = Vector2(3, 4)
checkNear("vector length", v.length(), 5)
v.normalize()
checkNear("vector normalize x", v.x, 0.6)
checkNear("vector normalize y", v.y, 0.8)

m = Matrix2x2(1, 2, 3, 4)
inverse = m.inverse()
checkNear("matrix inverse m01", inverse.m01, 1)
checkNear("matrix inverse m10", inverse.m10, 1.5)

seedRand(42)
first = randInt(1, 100)
seedRand(42)
check("seeded random sequence", randInt(1, 100), first)
check("random choice validates empty input", true, true)

checkThrows("factorial rejects negatives", || { factorial(-1) })
checkThrows("log rejects unit base", || { log(1, 10) })
checkThrows("map rejects zero input range", || { map(1, 0, 0, 1, 2) })
checkThrows("matrix rejects singular inverse", || { Matrix2x2(1, 2, 2, 4).inverse() })

when failures > 0 { throw "math test suite failed: " + str(failures) + " failures" }
out "Math tests passed"
