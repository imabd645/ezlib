# ============================================================================
# diff — text and sequence diffing for EZ
#
#   use "diff"
#
#   out Diff.unified(oldText, newText, "before.txt", "after.txt")
#
# Line diffing built on a longest-common-subsequence pass, so an inserted line
# is reported as one insertion rather than as every following line changing.
# ============================================================================

use "diff/lcs.ez"

task splitLines(text) {
    when text == nil { give [] }
    body = replace(replace(str(text), chr(13) + chr(10), chr(10)), chr(13), chr(10))
    when body == "" { give [] }
    # A trailing newline marks the end of the last line, not an empty line
    # after it -- keeping it would report a spurious change on every file.
    when endsWith(body, chr(10)) { body = substr(body, 0, len(body) - 1) }
    give split(body, chr(10))
}

export model Diff {

    # ── raw comparison ──────────────────────────────────────────────────────

    # Edit script over lines: [{ op, value }] with op keep/add/remove.
    static task lines(oldText, newText) {
        give diffSequences(splitLines(oldText), splitLines(newText))
    }

    # Edit script over any two lists.
    static task sequences(a, b) { give diffSequences(a, b) }

    # Edit script over characters. Useful for short strings; the table is
    # quadratic, so this is the wrong tool for whole documents.
    static task chars(a, b) {
        give diffSequences(toChars(a), toChars(b))
    }

    static task isSame(oldText, newText) {
        get op in Diff.lines(oldText, newText) {
            when op["op"] != "keep" { give false }
        }
        give true
    }

    # { added, removed, unchanged }
    static task stats(oldText, newText) {
        added = 0
        removed = 0
        kept = 0
        get op in Diff.lines(oldText, newText) {
            when op["op"] == "add" { added = added + 1 }
            other when op["op"] == "remove" { removed = removed + 1 }
            other { kept = kept + 1 }
        }
        give { "added": added, "removed": removed, "unchanged": kept }
    }

    # ── formatted output ────────────────────────────────────────────────────

    # Every line prefixed with a marker. Simple, and fine for short inputs.
    static task inline(oldText, newText) {
        parts = []
        get op in Diff.lines(oldText, newText) {
            when op["op"] == "add" { push(parts, "+ " + op["value"]) }
            other when op["op"] == "remove" { push(parts, "- " + op["value"]) }
            other { push(parts, "  " + op["value"]) }
        }
        give join(parts, chr(10))
    }

    # Only the changed lines, without context.
    static task changesOnly(oldText, newText) {
        parts = []
        get op in Diff.lines(oldText, newText) {
            when op["op"] == "add" { push(parts, "+ " + op["value"]) }
            other when op["op"] == "remove" { push(parts, "- " + op["value"]) }
        }
        give join(parts, chr(10))
    }

    # Unified diff, the format patch and git speak. Three lines of context by
    # default; changes closer together than that are merged into one hunk.
    static task unified(oldText, newText, oldName, newName) {
        give Diff.unifiedWith(oldText, newText, oldName, newName, 3)
    }

    static task unifiedWith(oldText, newText, oldName, newName, context) {
        ops = Diff.lines(oldText, newText)
        hunks = Diff.buildHunks(ops, context)
        when len(hunks) == 0 { give "" }

        lines = []
        push(lines, "--- " + str(oldName))
        push(lines, "+++ " + str(newName))
        get hunk in hunks {
            push(lines, Diff.hunkHeader(hunk))
            get entry in hunk["lines"] {
                when entry["op"] == "add" { push(lines, "+" + entry["value"]) }
                other when entry["op"] == "remove" { push(lines, "-" + entry["value"]) }
                other { push(lines, " " + entry["value"]) }
            }
        }
        give join(lines, chr(10))
    }

    static task hunkHeader(hunk) {
        head = "@@ -" + str(hunk["oldStart"]) + "," + str(hunk["oldCount"])
        head = head + " +" + str(hunk["newStart"]) + "," + str(hunk["newCount"])
        give head + " @@"
    }

    # Groups changes into hunks with `context` unchanged lines around each.
    static task buildHunks(ops, context) {
        # Number every op with its position in each file first, so a hunk
        # header can state where it starts without re-deriving it.
        numbered = []
        oldLine = 1
        newLine = 1
        get op in ops {
            entry = {
                "op": op["op"],
                "value": op["value"],
                "oldLine": oldLine,
                "newLine": newLine
            }
            when op["op"] == "keep" { oldLine = oldLine + 1  newLine = newLine + 1 }
            other when op["op"] == "remove" { oldLine = oldLine + 1 }
            other { newLine = newLine + 1 }
            push(numbered, entry)
        }

        # Which lines to include: every change, plus `context` either side.
        include = []
        total = len(numbered)
        repeat i = 0 to total - 1 { push(include, false) }
        index = 0
        get entry in numbered {
            when entry["op"] != "keep" {
                # NOT `to`: it is the keyword in `repeat i = 1 to n`.
                first = index - context
                when first < 0 { first = 0 }
                last = index + context
                when last > total - 1 { last = total - 1 }
                repeat j = first to last { include[j] = true }
            }
            index = index + 1
        }

        hunks = []
        current = nil
        index = 0
        while index < total {
            when include[index] == false {
                when current != nil { push(hunks, current)  current = nil }
                index = index + 1
                skip
            }
            entry = numbered[index]
            when current == nil {
                current = {
                    "oldStart": entry["oldLine"],
                    "newStart": entry["newLine"],
                    "oldCount": 0,
                    "newCount": 0,
                    "lines": []
                }
            }
            push(current["lines"], entry)
            when entry["op"] != "add" { current["oldCount"] = current["oldCount"] + 1 }
            when entry["op"] != "remove" { current["newCount"] = current["newCount"] + 1 }
            index = index + 1
        }
        when current != nil { push(hunks, current) }
        give hunks
    }

    # ── word level ──────────────────────────────────────────────────────────

    # Diff by word rather than line, for prose where a whole paragraph is one
    # line and a line diff would say only that it changed.
    static task words(oldText, newText) {
        give diffSequences(split(str(oldText), " "), split(str(newText), " "))
    }

    # Word diff rendered inline with [-removed-] and {+added+} markers.
    static task wordsInline(oldText, newText) {
        parts = []
        get op in Diff.words(oldText, newText) {
            when op["op"] == "add" { push(parts, "{+" + op["value"] + "+}") }
            other when op["op"] == "remove" { push(parts, "[-" + op["value"] + "-]") }
            other { push(parts, op["value"]) }
        }
        give join(parts, " ")
    }

    # ── applying ────────────────────────────────────────────────────────────

    # Reconstructs the new text from an edit script, which is what makes the
    # script verifiable: applying it must reproduce the target exactly.
    static task apply(ops) {
        parts = []
        get op in ops {
            when op["op"] != "remove" { push(parts, op["value"]) }
        }
        give join(parts, chr(10))
    }

    # The reverse script, turning new back into old.
    static task invert(ops) {
        flipped = []
        get op in ops {
            when op["op"] == "add" { push(flipped, { "op": "remove", "value": op["value"] }) }
            other {
                when op["op"] == "remove" { push(flipped, { "op": "add", "value": op["value"] }) }
                other { push(flipped, op) }
            }
        }
        give flipped
    }
}

task toChars(text) {
    chars = []
    body = str(text)
    total = len(body)
    repeat i = 0 to total - 1 { push(chars, substr(body, i, 1)) }
    give chars
}

# ── shorthands ──────────────────────────────────────────────────────────────

export task diffLines(a, b) { give Diff.inline(a, b) }
export task diffUnified(a, b) { give Diff.unified(a, b, "a", "b") }
export task diffStats(a, b) { give Diff.stats(a, b) }
