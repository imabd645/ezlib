# ============================================================================
# wa_store.ez — Session key storage for WhatsApp credentials
#
# Persists the static key pair and session tokens to disk so you don't need
# to scan the QR code every time. Stored in ./wa_session.json (plaintext).
#
# Depends on: wa_crypto.ez (wac_generateKeyPair, wac_randomBytes, Base64)
# ============================================================================

use "wa_crypto.ez"

_WA_SESSION_FILE = "wa_session.json"


# Use Kernel32 GetFileAttributesA for reliable file-exists check
__wastore_k32    = os_load_lib("Kernel32.dll")
_wastore_getAttr = os_get_func(__wastore_k32, "GetFileAttributesA")
_WASTORE_INVALID = 4294967295  # INVALID_FILE_ATTRIBUTES = 0xFFFFFFFF

task _wastore_fileExists(path) {
    attr = os_call(_wastore_getAttr, "int", path)
    give attr != _WASTORE_INVALID
}

export model WAStore {
    init() {
        self.staticKeyPair = {}
        self.clientId      = []
        self.serverToken   = ""
        self.clientToken   = ""
        self.encKey        = []
        self.macKey        = []
        self.phoneNumber   = ""
        self.loaded        = false
    }

    # ── Generate new credentials (first run) ─────────────────────────────────
    task generate() {
        self.staticKeyPair = wac_generateKeyPair()
        self.clientId      = wac_randomBytes(16)
        self.loaded        = true
    }

    # ── Save session to disk as JSON ──────────────────────────────────────────
    task save() {
        data = "{\n"
        data = data + "  \"clientId\": \"" + Base64.encode(self.clientId) + "\",\n"
        data = data + "  \"staticPublic\": \"" + Base64.encode(self.staticKeyPair["public"]) + "\",\n"
        data = data + "  \"staticPrivate\": \"" + Base64.encode(self.staticKeyPair["private"]) + "\",\n"
        data = data + "  \"serverToken\": \"" + self.serverToken + "\",\n"
        data = data + "  \"clientToken\": \"" + self.clientToken + "\",\n"
        data = data + "  \"phoneNumber\": \"" + self.phoneNumber + "\"\n"
        data = data + "}"
        writeFile(_WA_SESSION_FILE, data)
    }

    # ── Load session from disk ────────────────────────────────────────────────
    task load() {
        when not _wastore_fileExists(_WA_SESSION_FILE) { give false }
        raw = readFile(_WA_SESSION_FILE)
        when raw == "" or raw == nil { give false }

        # Minimal JSON field extractor
        task extractField(json, key) {
            searchKey = "\"" + key + "\": \""
            startIdx = indexOf(json, searchKey)
            when startIdx < 0 { give "" }
            startIdx = startIdx + len(searchKey)
            endIdx = startIdx
            while endIdx < len(json) and substr(json, endIdx, 1) != "\"" {
                endIdx = endIdx + 1
            }
            give substr(json, startIdx, endIdx - startIdx)
        }

        clientIdB64      = extractField(raw, "clientId")
        staticPublicB64  = extractField(raw, "staticPublic")
        staticPrivateB64 = extractField(raw, "staticPrivate")
        self.serverToken = extractField(raw, "serverToken")
        self.clientToken = extractField(raw, "clientToken")
        self.phoneNumber = extractField(raw, "phoneNumber")

        when clientIdB64 == "" { give false }

        self.clientId = Base64.decodeToBytes(clientIdB64)
        self.staticKeyPair = {
            "public":  Base64.decodeToBytes(staticPublicB64),
            "private": Base64.decodeToBytes(staticPrivateB64)
        }
        self.loaded = true
        give true
    }

    task hasSession() {
        give self.loaded and len(self.clientId) > 0 and self.serverToken != ""
    }

    task clientIdB64() { give Base64.encode(self.clientId) }
}
