# ============================================================================
# main.ez — WhatsApp Web client for EZ (Baileys-style)
#
# Architecture:
#   wa_crypto.ez  <- Curve25519 ECDH, AES-256-GCM, HMAC, HKDF (bcrypt.dll)
#   wa_noise.ez   <- Noise Protocol XX handshake state machine
#   wa_ws.ez      <- WebSocket connection via WinHTTP.dll
#   wa_proto.ez   <- Binary node encoder/decoder
#   wa_qr.ez      <- QR code ASCII art renderer
#   wa_store.ez   <- Session credential storage
#   main.ez       <- Public facade: WAClient model
#
# Usage:
#   use "whatsapp"
#   wa = WAClient()
#   wa.connect()      # opens connection + Noise handshake
#   wa.waitForQR()    # prints QR, blocks until scanned
#   wa.on("message", |msg| { out msg["from"] + ": " + msg["text"] })
#   wa.sendText("1234567890@s.whatsapp.net", "Hello!")
#   wa.loop()         # keeps connection alive
# ============================================================================

use "wa_crypto.ez"
use "wa_noise.ez"
use "wa_ws.ez"
use "wa_proto.ez"
use "wa_qr.ez"
use "wa_store.ez"

// ── WhatsApp message type constants ───────────────────────────────────────────
export WA_MSG_TEXT     = "conversation"
export WA_MSG_IMAGE    = "imageMessage"
export WA_MSG_DOCUMENT = "documentMessage"
export WA_MSG_AUDIO    = "audioMessage"
export WA_MSG_VIDEO    = "videoMessage"
export WA_MSG_STICKER  = "stickerMessage"

// ── Connection state ──────────────────────────────────────────────────────────
_WA_DISCONNECTED = 0
_WA_CONNECTING   = 1
_WA_HANDSHAKING  = 2
_WA_QR_WAIT      = 3
_WA_CONNECTED    = 4

// ── WhatsApp Web client model ─────────────────────────────────────────────────
export model WAClient {
    init() {
        self.ws      = WAWebSocket()
        self.noise   = WANoise()
        self.store   = WAStore()
        self.state   = _WA_DISCONNECTED

        // Message ID counter (monotonic)
        self._msgCounter = 1

        // Event handlers: dict of event name -> list of callbacks
        self._handlers = {}

        // Pending ACK table: msgId -> { resolve, reject }
        self._pending = {}

        // Internal message queue for the receive loop
        self._msgQueue = []
    }

    // ── Register an event handler ─────────────────────────────────────────────
    task on(event, callback) {
        when type(self._handlers[event]) == "nil" {
            self._handlers[event] = []
        }
        push(self._handlers[event], callback)
        give self
    }

    // ── Fire an event to all registered handlers ──────────────────────────────
    task _emit(event, data) {
        when type(self._handlers[event]) != "nil" {
            get cb in self._handlers[event] { cb(data) }
        }
    }

    // ── Generate a unique message ID ──────────────────────────────────────────
    task _nextMsgId() {
        id = "EZ" + str(self._msgCounter)
        self._msgCounter = self._msgCounter + 1
        give id
    }

    // ── Load or generate credentials ──────────────────────────────────────────
    task _ensureCredentials() {
        loaded = self.store.load()
        when not loaded {
            self.store.generate()
        }
    }

    // ── Connect: establish WebSocket + Noise handshake ────────────────────────
    task connect() {
        self.state = _WA_CONNECTING
        out "[WA] Connecting to WhatsApp Web..."

        self._ensureCredentials()
        self.noise.initialize(self.store.staticKeyPair)

        // Connect WebSocket
        self.ws.connect()
        out "[WA] WebSocket connected ✓"
        self.state = _WA_HANDSHAKING

        // Build and send ClientHello (Noise XX -> e)
        clientHelloPayload = self.noise.buildClientHello()
        helloFrame = wap_buildFrame(clientHelloPayload, false)

        // Send unencrypted WA prologue (WA, 6, 3) + frame
        prologue = [87, 65, 6, 3]
        fullFrame = []
        get b in prologue { push(fullFrame, b) }
        get b in helloFrame { push(fullFrame, b) }
        self.ws.sendBinary(fullFrame)
        out "[WA] ClientHello sent ✓"

        // Receive ServerHello (Noise XX -> e, ee, s, es)
        serverHelloFrame = self.ws.receiveBinary()
        when serverHelloFrame == nil {
            throw "[WA] No response from server — connection rejected"
        }
        hdr = wap_parseFrameHeader(serverHelloFrame)
        when hdr == nil { throw "[WA] Invalid frame from server" }
        serverHelloPayload = _wac_sliceBytes(serverHelloFrame, 3, hdr["size"])
        self.noise.processServerHello(serverHelloPayload)
        out "[WA] ServerHello processed ✓"

        // Build and send ClientFinish (Noise XX -> s, se)
        clientFinishPayload = self.noise.buildClientFinish()
        finishFrame = wap_buildFrame(clientFinishPayload, false)
        self.ws.sendBinary(finishFrame)
        out "[WA] ClientFinish sent — Noise handshake complete ✓"

        out "[WA] Connected! Waiting for QR code or session resume..."
        self.state = _WA_QR_WAIT
    }


    // ── Encrypt and send a binary node ────────────────────────────────────────
    task _sendNode(node) {
        nodeBytes = wap_encodeNode(node)
        frame = nil
        when self.noise.isReady() {
            encrypted = self.noise.encrypt(nodeBytes)
            frame = wap_buildFrame(encrypted, false)
        }
        when not self.noise.isReady() {
            frame = wap_buildFrame(nodeBytes, false)
        }
        self.ws.sendBinary(frame)
    }

    // ── Receive and decrypt the next binary node ───────────────────────────────
    task _receiveNode() {
        raw = self.ws.receiveBinary()
        when raw == nil { give nil }

        hdr = wap_parseFrameHeader(raw)
        when hdr == nil { give nil }

        payloadLen = len(raw) - 3
        when payloadLen < 0 { payloadLen = 0 }
        payload = _wac_sliceBytes(raw, 3, payloadLen)
        out "Raw length: " + str(len(raw)) + ", payload length: " + str(len(payload))

        when self.noise.isReady() {
            when len(payload) < 16 {
                out "Payload too short to decrypt, length: " + str(len(payload))
                out "Payload bytes: " + str(payload)
                give nil
            }
            out "Decrypting payload..."
            payload = self.noise.decrypt(payload)
        }

        // Decode the WABinary node (skip 1 byte compression flag)
        // TODO: Handle zlib compression if payload[0] & 2 is true
        parsed = wap_decodeNode(payload, 1)
        when parsed == nil { give nil }
        give parsed["node"]
    }

    // ── Block until QR code is received and scanned ───────────────────────────
    task waitForQR() {
        out "[WA] Waiting for QR code from server..."

        while self.state == _WA_QR_WAIT {
            node = self._receiveNode()
            when node != nil and type(node) == "dictionary" {
                tag = node["tag"]

                when tag == "iq" {
                    // server may send identity/registration challenge
                    self._handleIQ(node)
                }

                when tag == "ref" {
                    // QR reference from WhatsApp
                    qrRef = wac_bytesToStr(node["content"])
                    qrContent = waq_buildQRContent(
                        qrRef,
                        self.store.staticKeyPair["public"],
                        self.store.clientId
                    )
                    waq_printQR(qrContent)
                    out "[WA] Please scan the QR code above with your WhatsApp app."
                }

                when tag == "success" {
                    // Authentication succeeded!
                    attrs = node["attrs"]
                    self.store.serverToken = attrs["t"]
                    self.store.clientToken = attrs["t"]
                    self.store.phoneNumber = attrs["jid"]
                    self.store.save()

                    self.state = _WA_CONNECTED
                    out "[WA] ✅ Logged in! Phone: " + self.store.phoneNumber
                    self._emit("ready", { "phone": self.store.phoneNumber })
                    escape
                }

                when tag == "failure" {
                    attrs = node["attrs"]
                    throw "[WA] Authentication failed: " + str(attrs["reason"])
                }
            }
        }
    }

    // ── Handle IQ (info/query) nodes ──────────────────────────────────────────
    task _handleIQ(node) {
        attrs = node["attrs"]
        iqType = attrs["type"]
        iqId   = attrs["id"]

        // Respond to server keepalives
        when iqType == "get" {
            resp = {
                "tag": "iq",
                "attrs": { "to": "s.whatsapp.net", "type": "result", "id": iqId },
                "children": [],
                "content": nil
            }
            self._sendNode(resp)
        }
    }

    // ── Send a text message ───────────────────────────────────────────────────
    task sendText(jid, text) {
        when self.state != _WA_CONNECTED {
            throw "[WA] Not connected — call connect() and waitForQR() first"
        }

        msgId = self._nextMsgId()
        // os_call already returns an integer for an "int" return type, and there
        // is no int() builtin -- this threw the moment sendText() was called.
        ts    = str(os_call(_wac_GenRandom, "int", 0, 0, 0, 0))  // rough timestamp

        // Build message protobuf payload (simplified)
        msgProto = []
        textBytes = wac_strToBytes(text)

        // field 1 (conversation text) = length-delimited
        get b in wap_encodeBytes(1, textBytes) { push(msgProto, b) }

        node = {
            "tag": "message",
            "attrs": {
                "to":   jid,
                "id":   msgId,
                "type": "text"
            },
            "children": [],
            "content": msgProto
        }
        self._sendNode(node)
        give msgId
    }

    // ── Send an image message ─────────────────────────────────────────────────
    task sendImage(jid, imageBytes, caption) {
        when self.state != _WA_CONNECTED {
            throw "[WA] Not connected"
        }

        msgId = self._nextMsgId()

        // Encrypt image with random key (WhatsApp media encryption)
        mediaKey = wac_randomBytes(32)
        iv       = wac_randomBytes(12)
        // adBytes is required; nil means "no additional authenticated data",
        // the same way wa_noise.ez calls it. Omitting it was an arity error.
        encrypted = wac_aesGcmEncrypt(mediaKey, iv, imageBytes, nil)

        // Build imageMessage protobuf
        imgProto = []
        // field 1: url (placeholder — real upload requires separate HTTP call)
        urlBytes = wac_strToBytes("https://mmg.whatsapp.net/placeholder")
        get b in wap_encodeBytes(1, urlBytes) { push(imgProto, b) }
        // field 4: media key
        get b in wap_encodeBytes(4, mediaKey) { push(imgProto, b) }
        // field 16: caption
        when type(caption) != "nil" and caption != "" {
            capBytes = wac_strToBytes(caption)
            get b in wap_encodeBytes(16, capBytes) { push(imgProto, b) }
        }

        node = {
            "tag": "message",
            "attrs": { "to": jid, "id": msgId, "type": "image" },
            "children": [],
            "content": imgProto
        }
        self._sendNode(node)
        give msgId
    }

    // ── Send a typing presence indicator ─────────────────────────────────────
    task sendTyping(jid) {
        node = {
            "tag": "chatstate",
            "attrs": { "to": jid },
            "children": [
                { "tag": "composing", "attrs": {}, "children": [], "content": nil }
            ],
            "content": nil
        }
        self._sendNode(node)
    }

    // ── Send a read receipt ───────────────────────────────────────────────────
    task markRead(jid, msgId) {
        node = {
            "tag": "receipt",
            "attrs": { "to": jid, "id": msgId, "type": "read" },
            "children": [],
            "content": nil
        }
        self._sendNode(node)
    }

    // ── Process one incoming message frame ────────────────────────────────────
    task _processIncoming(node) {
        when node == nil { give false }
        tag = node["tag"]

        when tag == "message" {
            attrs    = node["attrs"]
            from     = attrs["from"]
            msgId    = attrs["id"]
            msgType  = attrs["type"]

            content = node["content"]
            text = ""
            when type(content) != "nil" {
                // Try decode protobuf field 1 = conversation text
                when len(content) > 2 {
                    // field 1, wire type 2 = 0x0A
                    when content[0] == 10 {
                        textLen = content[1]
                        textBytes2 = _wac_sliceBytes(content, 2, textLen)
                        text = wac_bytesToStr(textBytes2)
                    }
                }
            }

            msg = {
                "id":      msgId,
                "from":    from,
                "type":    msgType,
                "text":    text,
                "content": content
            }
            self._emit("message", msg)
            give true
        }

        when tag == "iq"       { self._handleIQ(node)  give true }
        when tag == "presence" {
            attrs = node["attrs"]
            self._emit("presence", { "from": attrs["from"], "type": attrs["type"] })
            give true
        }
        when tag == "chatstate" { give true }

        give false
    }

    // ── Main event loop (blocking) ─────────────────────────────────────────────
    task loop() {
        out "[WA] Entering message loop. Press Ctrl+C to stop."
        while self.state == _WA_CONNECTED {
            node = self._receiveNode()
            self._processIncoming(node)
        }
        out "[WA] Message loop ended."
    }

    // ── Poll for one message (non-blocking — checks for queued messages) ──────
    task poll() {
        when self.state != _WA_CONNECTED { give nil }
        node = self._receiveNode()
        self._processIncoming(node)
        give node
    }

    // ── Disconnect cleanly ────────────────────────────────────────────────────
    task disconnect() {
        when self.state != _WA_DISCONNECTED {
            // Send stream end
            node = {
                "tag": "stream:end",
                "attrs": {},
                "children": [],
                "content": nil
            }
            self._sendNode(node)
        }
        self.ws.disconnect()
        self.state = _WA_DISCONNECTED
        out "[WA] Disconnected."
    }

    // ── Get connection status ─────────────────────────────────────────────────
    task isConnected() { give self.state == _WA_CONNECTED }
    task status() {
        when self.state == _WA_DISCONNECTED { give "disconnected" }
        when self.state == _WA_CONNECTING   { give "connecting"   }
        when self.state == _WA_HANDSHAKING  { give "handshaking"  }
        when self.state == _WA_QR_WAIT      { give "waiting_qr"   }
        when self.state == _WA_CONNECTED    { give "connected"     }
        give "unknown"
    }
}
