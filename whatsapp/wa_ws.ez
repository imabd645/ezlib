# ============================================================================
# wa_ws.ez — WebSocket client for WhatsApp Web over WinHTTP
#
# Connects to wss://web.whatsapp.com/ws/chat with required headers.
# Provides raw frame send/receive that the Noise layer uses.
#
# Depends on: wa_crypto.ez (_wac_writeBytes, _wac_readBytes)
# ============================================================================

use "wa_crypto.ez"

__wa_winhttp = os_load_lib("winhttp.dll")
when __wa_winhttp == 0 {
    throw "wa_ws: winhttp.dll not found"
}

# ── WinHTTP function pointers ─────────────────────────────────────────────────
_ws_Open        = os_get_func(__wa_winhttp, "WinHttpOpen")
_ws_Connect     = os_get_func(__wa_winhttp, "WinHttpConnect")
_ws_OpenRequest = os_get_func(__wa_winhttp, "WinHttpOpenRequest")
_ws_SetHeaders  = os_get_func(__wa_winhttp, "WinHttpAddRequestHeaders")
_ws_SendRequest = os_get_func(__wa_winhttp, "WinHttpSendRequest")
_ws_ReceiveResp = os_get_func(__wa_winhttp, "WinHttpReceiveResponse")
_ws_SetOption   = os_get_func(__wa_winhttp, "WinHttpSetOption")
_ws_Upgrade     = os_get_func(__wa_winhttp, "WinHttpWebSocketCompleteUpgrade")
_ws_WsSend      = os_get_func(__wa_winhttp, "WinHttpWebSocketSend")
_ws_WsReceive   = os_get_func(__wa_winhttp, "WinHttpWebSocketReceive")
_ws_WsClose     = os_get_func(__wa_winhttp, "WinHttpWebSocketClose")
_ws_CloseHandle = os_get_func(__wa_winhttp, "WinHttpCloseHandle")
_ws_QueryHeaders= os_get_func(__wa_winhttp, "WinHttpQueryHeaders")

# ── WinHTTP constants ─────────────────────────────────────────────────────────
_WINHTTP_FLAG_SECURE                 = 0x00800000
_WINHTTP_OPTION_UPGRADE_TO_WEB_SOCKET= 114
_WINHTTP_ACCESS_TYPE_NO_PROXY        = 1
_WINHTTP_NO_REFERER                  = 0
_WINHTTP_DEFAULT_ACCEPT_TYPES        = 0
_WINHTTP_WEB_SOCKET_BINARY_MESSAGE_BUFFER_TYPE = 0
_WINHTTP_WEB_SOCKET_BINARY_FRAGMENT_BUFFER_TYPE= 1

# ── Helper: write a wide (UTF-16LE) string into an FFI buffer ─────────────────
task _ws_toWide(s) {
    buf = os_alloc((len(s) + 2) * 2)
    repeat i = 0 to len(s) - 1 {
        os_write_byte(buf, i * 2,     ord(substr(s, i, 1)))
        os_write_byte(buf, i * 2 + 1, 0)
    }
    os_write_byte(buf, len(s) * 2,     0)
    os_write_byte(buf, len(s) * 2 + 1, 0)
    give buf
}

# ── WebSocket connection model ─────────────────────────────────────────────────
model WAWebSocket {
    init() {
        self.hSession  = 0
        self.hConnect  = 0
        self.hRequest  = 0
        self.hSocket   = 0
        self.connected = false
    }

    # ── Connect to WhatsApp Web WebSocket ─────────────────────────────────────
    task connect() {
        userAgentBuf = _ws_toWide("Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36")
        userAgentBuf = _ws_toWide("Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36")
        self.hSession = os_call(_ws_Open, "ptr", userAgentBuf,
                                _WINHTTP_ACCESS_TYPE_NO_PROXY, 0, 0, 0)
        os_free(userAgentBuf)

        when self.hSession == 0 {
            throw "wa_ws: WinHttpOpen failed"
        }

        # Connect to web.whatsapp.com:443
        hostBuf = _ws_toWide("web.whatsapp.com")
        self.hConnect = os_call(_ws_Connect, "ptr", self.hSession, hostBuf, 443, 0)
        os_free(hostBuf)

        when self.hConnect == 0 {
            os_call(_ws_CloseHandle, "int", self.hSession)
            throw "wa_ws: WinHttpConnect failed"
        }

        # Open HTTPS GET request for WebSocket upgrade
        pathBuf = _ws_toWide("/ws/chat")
        self.hRequest = os_call(_ws_OpenRequest, "ptr",
                                self.hConnect, 0, pathBuf, 0, 0, 0,
                                _WINHTTP_FLAG_SECURE)
        os_free(pathBuf)

        when self.hRequest == 0 {
            os_call(_ws_CloseHandle, "int", self.hConnect)
            os_call(_ws_CloseHandle, "int", self.hSession)
            throw "wa_ws: WinHttpOpenRequest failed"
        }

        # Set WebSocket upgrade option (must be NULL buffer)
        os_call(_ws_SetOption, "int", self.hRequest,
                _WINHTTP_OPTION_UPGRADE_TO_WEB_SOCKET, 0, 0)

        # Add required WhatsApp headers
        headers = "Host: web.whatsapp.com\r\nOrigin: https://web.whatsapp.com\r\n"
        headers = headers + "Sec-WebSocket-Protocol: chat\r\n"
        hdrBuf = _ws_toWide(headers)
        os_call(_ws_SetHeaders, "int", self.hRequest, hdrBuf, -1, 536870912) # WINHTTP_ADDREQ_FLAG_ADD
        os_free(hdrBuf)

        # Send upgrade request
        rc = os_call(_ws_SendRequest, "int", self.hRequest, 0, 0, 0, 0, 0, 0)
        when rc == 0 {
            os_call(_ws_CloseHandle, "int", self.hRequest)
            os_call(_ws_CloseHandle, "int", self.hConnect)
            os_call(_ws_CloseHandle, "int", self.hSession)
            throw "wa_ws: WinHttpSendRequest failed"
        }

        rc2 = os_call(_ws_ReceiveResp, "int", self.hRequest, 0)
        when rc2 == 0 {
            os_call(_ws_CloseHandle, "int", self.hRequest)
            os_call(_ws_CloseHandle, "int", self.hConnect)
            os_call(_ws_CloseHandle, "int", self.hSession)
            throw "wa_ws: WinHttpReceiveResponse failed"
        }

        # Complete WebSocket upgrade
        self.hSocket = os_call(_ws_Upgrade, "ptr", self.hRequest, 0)
        when self.hSocket == 0 {
            os_call(_ws_CloseHandle, "int", self.hRequest)
            os_call(_ws_CloseHandle, "int", self.hConnect)
            os_call(_ws_CloseHandle, "int", self.hSession)
            throw "wa_ws: WebSocket upgrade failed — WhatsApp rejected the connection"
        }

        self.connected = true
    }

    # ── Send raw bytes as a binary WebSocket frame ────────────────────────────
    task sendBinary(byteList) {
        when not self.connected { throw "wa_ws: not connected" }
        dataLen = len(byteList)
        buf = os_alloc(dataLen + 1)
        _wac_writeBytes(buf, byteList)
        rc = os_call(_ws_WsSend, "int", self.hSocket,
                     _WINHTTP_WEB_SOCKET_BINARY_MESSAGE_BUFFER_TYPE,
                     buf, dataLen)
        os_free(buf)
        when rc != 0 { throw "wa_ws: send failed rc=" + str(rc) }
    }

    # ── Receive the next binary WebSocket frame ───────────────────────────────
    # Returns byte list or nil on close
    task receiveBinary() {
        when not self.connected { give nil }

        bufSize = 131072  # 128KB receive buffer
        buf = os_alloc(bufSize)
        bytesReadBuf = os_alloc(8)
        bufTypeBuf   = os_alloc(8)

        fullData = []
        while true {
            rc = os_call(_ws_WsReceive, "int", self.hSocket,
                         buf, bufSize, bytesReadBuf, bufTypeBuf)
            when rc != 0 {
                os_free(buf)
                os_free(bytesReadBuf)
                os_free(bufTypeBuf)
                give nil  # connection closed
            }

            bytesRead = os_read_uint64(bytesReadBuf, 0) & 0xFFFFFFFF
            bufType   = os_read_uint64(bufTypeBuf,   0) & 0xFFFFFFFF

            repeat i = 0 to bytesRead - 1 {
                push(fullData, os_read_byte(buf, i) & 255)   # one byte, not eight
            }

            out "bufType: " + str(bufType) + ", bytesRead: " + str(bytesRead)

            # BINARY_MESSAGE = 0 means complete frame received
            when bufType == 0 { 
                os_free(buf)
                os_free(bytesReadBuf)
                os_free(bufTypeBuf)
                give fullData 
            }
            # BINARY_FRAGMENT = 1 means partial frame received, keep looping
            when bufType == 1 {
                # continue looping to read more fragments
            }
            # CLOSE = 4
            when bufType == 4 { 
                out "WebSocket Close received!"
                os_free(buf)
                os_free(bytesReadBuf)
                os_free(bufTypeBuf)
                give nil
            }
        }

        os_free(buf)
        os_free(bytesReadBuf)
        os_free(bufTypeBuf)
        give fullData
    }

    # ── Disconnect ────────────────────────────────────────────────────────────
    task disconnect() {
        when self.hSocket  != 0 { os_call(_ws_WsClose,     "int", self.hSocket,  1000, 0, 0) }
        when self.hRequest != 0 { os_call(_ws_CloseHandle, "int", self.hRequest) }
        when self.hConnect != 0 { os_call(_ws_CloseHandle, "int", self.hConnect) }
        when self.hSession != 0 { os_call(_ws_CloseHandle, "int", self.hSession) }
        self.connected = false
        self.hSocket   = 0
        self.hRequest  = 0
        self.hConnect  = 0
        self.hSession  = 0
    }
}
