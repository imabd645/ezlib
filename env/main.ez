// ============================================================================
// ezenv -- .env and system environment loading for EZ.
//
//   use "env"
//
//   env = load()                          // loads .env from cwd
//   env = load(".env", { "system": true }) // server/host env > .env
//   port = env.getInt("PORT", 8080)
//   debug = env.getBool("DEBUG", false)
// ============================================================================

use "src/errors.ez"
use "src/parser.ez"
use "src/sys_env.ez"
use "src/store.ez"

// Direct accessor for host system/server environment variables
export task sys(key, fallback = nil) {
    val = SysEnv.get(key)
    when val != nil and val != "" { give val }
    give fallback
}

// Load a .env file and return an Env instance.
//
// Options:
//   system     (bool)   if true, host environment variables take precedence.
//   populate   (bool)   if true, exports .env variables into the host OS process.
//   required   (array)  keys that must be present in .env OR host environment.
//   defaults   (dict)   fallback values merged in for keys not in the file.
export task load(path = ".env", options = nil) {
    when typeOf(options) == "nil" { options = {} }

    data = parse_file(path)
    env = Env(data, options)

    // Merge defaults
    when has_key(options, "defaults") {
        env.merge(options["defaults"], false)
    }

    // Populate into system environment if requested
    when has_key(options, "populate") and options["populate"] {
        env.populate(false)
    }

    // Register and validate required keys
    when has_key(options, "required") {
        env.require(options["required"])
        env.validate()
    }

    give env
}

// Load from raw string content.
export task load_string(content, options = nil) {
    when typeOf(options) == "nil" { options = {} }

    data = parse(content, "<string>")
    env = Env(data, options)

    when has_key(options, "defaults") {
        env.merge(options["defaults"], false)
    }

    when has_key(options, "populate") and options["populate"] {
        env.populate(false)
    }

    when has_key(options, "required") {
        env.require(options["required"])
        env.validate()
    }

    give env
}

// Load multiple .env files and merge them in order.
export task load_files(paths, priority = "first", options = nil) {
    when typeOf(options) == "nil" { options = {} }
    env = Env({}, options)
    when priority == "last" {
        get path in paths {
            try {
                data = parse_file(path)
                env.merge(data, true)
            } catch e {}
        }
    } other {
        get path in paths {
            try {
                data = parse_file(path)
                env.merge(data, false)
            } catch e {}
        }
    }
    when has_key(options, "populate") and options["populate"] {
        env.populate(false)
    }
    give env
}
