// ============================================================================
// ezenv / store.ez -- the Env model.
//
// Wraps the flat { key: value } dictionary returned by the parser and adds the
// API you actually use at runtime: get, set, has, require, typed accessors,
// and host system/server environment synchronization.
// ============================================================================

use "errors.ez"
use "parser.ez"
use "sys_env.ez"

export model Env {
    // Construct an Env from a pre-parsed dictionary.
    init(data = nil, options = nil) {
        when typeOf(data) == "nil" { data = {} }
        when typeOf(options) == "nil" { options = {} }
        self._data = data
        self._required = []
        self._system = false

        when has_key(options, "system") {
            self._system = options["system"]
        }
    }

    // ── Core accessors ──────────────────────────────────────────────────

    // Get a value by key. Checks server environment if system option is enabled.
    task get(key, fallback = nil) {
        when self._system {
            sysVal = SysEnv.get(key)
            when sysVal != nil and sysVal != "" {
                give sysVal
            }
        }
        when has_key(self._data, key) {
            give self._data[key]
        }
        give fallback
    }

    // Set a value. Overwrites any existing value for this key in-memory.
    task set(key, value) {
        self._data[key] = str(value)
        give self
    }

    // Check if a key exists.
    task has(key) {
        when has_key(self._data, key) { give true }
        when self._system {
            sysVal = SysEnv.get(key)
            when sysVal != nil and sysVal != "" { give true }
        }
        give false
    }

    // Delete a key. No-op if it doesn't exist.
    task remove(key) {
        when has_key(self._data, key) {
            newData = {}
            get k in keys(self._data) {
                when k != key {
                    newData[k] = self._data[k]
                }
            }
            self._data = newData
        }
        give self
    }

    // Return all key-value pairs as a dictionary (shallow copy).
    task all() {
        result = {}
        get k in keys(self._data) {
            result[k] = self._data[k]
        }
        give result
    }

    // Return all keys as an array.
    task keys() {
        give keys(self._data)
    }

    // Return the number of variables loaded.
    task size() {
        give len(keys(self._data))
    }

    // Populate all in-memory variables into the host OS process environment
    task populate(overwrite = false) {
        get k in keys(self._data) {
            when overwrite or SysEnv.get(k) == nil {
                SysEnv.set(k, self._data[k])
            }
        }
        give self
    }

    // ── Required keys ───────────────────────────────────────────────────

    // Mark one or more keys as required.
    task require(keysOrKey) {
        when typeOf(keysOrKey) == "string" {
            push(self._required, keysOrKey)
        } other {
            get k in keysOrKey {
                push(self._required, k)
            }
        }
        give self
    }

    // Throw a KeyError for the first required key that is not set.
    task validate() {
        get k in self._required {
            found = has_key(self._data, k)
            when not found and self._system {
                sysVal = SysEnv.get(k)
                when sysVal != nil and sysVal != "" { found = true }
            }
            when not found {
                raise_key_error(k)
            }
        }
        give true
    }

    // ── Typed accessors ─────────────────────────────────────────────────

    // Get a value as an integer.
    task getInt(key, fallback = nil) {
        val = self.get(key)
        when val == nil { give fallback }
        result = nil
        try {
            result = num(val)
        } catch e {
            raise_type_error(key, "integer", val)
        }
        give result
    }

    // Get a value as a float.
    task getFloat(key, fallback = nil) {
        val = self.get(key)
        when val == nil { give fallback }
        result = nil
        try {
            result = num(val)
        } catch e {
            raise_type_error(key, "float", val)
        }
        give result
    }

    // Get a value as a boolean.
    task getBool(key, fallback = nil) {
        val = self.get(key)
        when val == nil { give fallback }
        raw = lower(str(val))
        when raw == "true" or raw == "1" or raw == "yes" or raw == "on" { give true }
        when raw == "false" or raw == "0" or raw == "no" or raw == "off" or raw == "" { give false }
        raise_type_error(key, "bool", val)
    }

    // Get a value as an array by splitting on a delimiter.
    task getList(key, delimiter = ",", fallback = nil) {
        val = self.get(key)
        when val == nil { give fallback }
        parts = split(str(val), delimiter)
        result = []
        get p in parts {
            trimmed = self._trimValue(p)
            when len(trimmed) > 0 {
                push(result, trimmed)
            }
        }
        give result
    }

    // ── Merge ───────────────────────────────────────────────────────────

    task merge(source_env, overwrite = false) {
        source = {}
        when typeOf(source_env) == "dictionary" {
            source = source_env
        } other {
            source = source_env.all()
        }
        get k in keys(source) {
            when overwrite or not has_key(self._data, k) {
                self._data[k] = source[k]
            }
        }
        give self
    }

    // ── Internal ────────────────────────────────────────────────────────

    task _trimValue(s) {
        start = 0
        l = len(s)
        found = false
        while start < l and not found {
            c = substring(s, start, 1)
            when c != " " and c != "\t" and c != "\r" and c != "\n" { 
                found = true 
            } other {
                start = start + 1
            }
        }
        end = l - 1
        found = false
        while end >= start and not found {
            c = substring(s, end, 1)
            when c != " " and c != "\t" and c != "\r" and c != "\n" { 
                found = true 
            } other {
                end = end - 1
            }
        }
        when start > end { give "" }
        give substring(s, start, end - start + 1)
    }
}
